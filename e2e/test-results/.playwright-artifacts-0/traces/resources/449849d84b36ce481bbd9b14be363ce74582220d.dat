        </div>\r
      </div>\r
\r
      <div class="flex gap-3">\r
        <button (click)="cerrarEditar()" class="flex-1 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-lg border border-slate-600">Cancelar</button>\r
        <button (click)="guardar()" class="flex-1 px-4 py-2 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-500 hover:to-blue-600 text-white font-semibold rounded-lg">Guardar</button>\r
      </div>\r
    </div>\r
  </div>\r
\r
  <!-- Notificaci\xF3n -->\r
  <div *ngIf="notificacion.mostrar" class="fixed bottom-6 right-6 z-50 px-5 py-3 rounded-xl text-sm font-semibold shadow-2xl"\r
       [ngClass]="notificacion.tipo === 'exito' ? 'bg-green-500/90 text-white' : 'bg-red-500/90 text-white'">\r
    {{ notificacion.mensaje }}\r
  </div>\r
\r
</div>\r
