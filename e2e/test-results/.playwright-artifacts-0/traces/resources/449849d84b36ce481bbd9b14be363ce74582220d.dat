      competicionId: this.competiciones[0]?.id || null,
      grupo: "\xDAnico",
      jornadas: 38,
      jornadaActual: 0,
      estado: "Activo"
    };
  }
  guardar() {
    if (!this.formulario.nombre || !this.formulario.competicionId) {
