        this.eventos = data;
        this.cdr.detectChanges();
      }
    });
  }
  agregarEvento() {
    if (this.nuevoEvento.jugadorId === 0 || this.nuevoEvento.minuto <= 0 || this.nuevoEvento.minuto > 120)
      return;
