  cargarLigas() {
    this.cargando = true;
    this.adminService.obtenerLigas().subscribe({
      next: (data) => {
        this.ligas = data;
        this.aplicarFiltro();
        this.cargando = false;
        this.cdr.detectChanges();
      },
