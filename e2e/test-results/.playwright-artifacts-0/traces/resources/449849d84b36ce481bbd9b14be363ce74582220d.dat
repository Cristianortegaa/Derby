\r
  <app-navbar></app-navbar>\r
\r
  <div class="h-20"></div>\r
\r
  <div class="absolute top-0 left-0 w-80 h-80 bg-blue-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
  <div class="absolute bottom-0 right-0 w-80 h-80 bg-red-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
\r
  <div class="relative z-10 px-6 md:px-12 py-6 max-w-7xl mx-auto w-full">\r
    <div class="flex items-center justify-between">\r
      <div>\r
        <h1 class="text-3xl md:text-4xl font-black mb-2 text-white mt-2">Historial de Partidos</h1>\r
        <p class="text-gray-500 text-sm md:text-base font-medium">Partidos arbitrados hist\xF3rico</p>\r
        <div class="h-1 w-16 bg-gradient-to-r from-red-400 to-blue-400 mt-3 rounded-full"></div>\r
      </div>\r
      <button routerLink="/arbitro"\r
              class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-blue-500/40 rounded-lg text-white hover:border-blue-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
        <i class="fas fa-arrow-left"></i> Volver\r
      </button>\r
    </div>\r
  </div>\r
\r
  <main class="relative z-10 flex-1 px-6 md:px-12 pb-20 max-w-7xl mx-auto w-full">\r
\r
    <!-- LISTA DE PARTIDOS -->\r
    <div class="bg-slate-900/80 backdrop-blur-md border border-blue-500/40 rounded-xl p-6 shadow-lg">\r
      @if (partidos.length > 0) {\r
        <div class="space-y-4">\r
          @for (partido of partidos; track partido.id) {\r
            <div class="bg-slate-800/50 border border-blue-500/30 rounded-lg p-6 hover:border-blue-400/60 transition-all">\r
              <div class="flex items-center justify-between mb-3">\r
                <h3 class="text-lg font-bold text-white">\r
                  {{ partido.equipoLocal.nombre }} <span class="text-red-400 font-black">{{ partido.golesLocal }}</span> -\r
                  <span class="text-blue-400 font-black">{{ partido.golesVisitante }}</span> {{ partido.equipoVisitante.nombre }}\r
                </h3>\r
                <span class="text-xs font-bold px-3 py-1 rounded-md bg-green-500/20 text-green-400">\r
                  Finalizado\r
                </span>\r
              </div>\r
\r
              <div class="flex gap-4 text-sm text-gray-400 flex-wrap">\r
                <span><i class="fas fa-calendar mr-1"></i>{{ partido.fechaHora | date: 'dd/MM/yyyy' }}</span>\r
                <span><i class="fas fa-clock mr-1"></i>{{ partido.fechaHora | date: 'HH:mm' }}</span>\r
                <span><i class="fas fa-map-marker-alt mr-1"></i>{{ partido.equipoLocal?.sede }}</span>\r
              </div>\r
\r
              @if (partido.observaciones) {\r
                <div class="mt-4 pt-4 border-t border-blue-500/20">\r
                  <p class="text-sm text-gray-400">\r
                    <strong>Observaciones:</strong> {{ partido.observaciones }}\r
                  </p>\r
                </div>\r
              }\r
\r
              <div class="mt-4">\r
                <button (click)="abrirDetalle(partido)" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold rounded-lg transition-all border border-blue-500/40">\r
                  <i class="fas fa-info-circle mr-1"></i>Detalles\r
                </button>\r
              </div>\r
            </div>\r
          }\r
        </div>\r
      } @else {\r
        <div class="text-center py-12">\r
          <i class="fas fa-inbox text-5xl text-gray-600 mb-4"></i>\r
          <p class="text-gray-400 text-lg">No tienes historial de partidos</p>\r
        </div>\r
      }\r
    </div>\r
  </main>\r
\r
  <!-- Modal detalles del partido -->\r
  <div *ngIf="modalDetalle.mostrar"\r
       class="fixed inset-0 z-50 flex items-center justify-center p-4"\r
       (click)="cerrarDetalle()">\r
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>\r
    <div class="relative z-10 w-full max-w-md bg-slate-900 rounded-2xl border border-blue-500/30 p-6 shadow-2xl"\r
         (click)="$event.stopPropagation()">\r
\r
      <div class="flex items-center justify-between mb-5">\r
        <h3 class="text-lg font-bold text-white">Detalles del partido</h3>\r
        <button (click)="cerrarDetalle()" class="text-gray-500 hover:text-white transition-colors">\r
          <i class="fas fa-xmark text-lg"></i>\r
        </button>\r
      </div>\r
\r
      <div class="text-center mb-5">\r
        <p class="text-xl font-black text-white">\r
          {{ modalDetalle.partido?.equipoLocal?.nombre }} vs {{ modalDetalle.partido?.equipoVisitante?.nombre }}\r
        </p>\r
        <span class="text-xs font-bold px-3 py-1 rounded-md mt-2 inline-block bg-green-500/20 text-green-400">\r
          Finalizado\r
        </span>\r
      </div>\r
\r
      <div class="space-y-3 text-sm">\r
        <div class="flex items-center gap-3 bg-slate-800/50 rounded-lg px-4 py-3">\r
          <i class="fas fa-calendar text-blue-400 w-4"></i>\r
          <span class="text-gray-400">Fecha</span>\r
          <span class="text-white ml-auto">{{ modalDetalle.partido?.fechaHora | date: 'dd/MM/yyyy' }}</span>\r
        </div>\r
        <div class="flex items-center gap-3 bg-slate-800/50 rounded-lg px-4 py-3">\r
          <i class="fas fa-clock text-blue-400 w-4"></i>\r
          <span class="text-gray-400">Hora</span>\r
          <span class="text-white ml-auto">{{ modalDetalle.partido?.fechaHora | date: 'HH:mm' }}</span>\r
        </div>\r
        <div class="flex items-center gap-3 bg-slate-800/50 rounded-lg px-4 py-3">\r
          <i class="fas fa-map-marker-alt text-blue-400 w-4"></i>\r
          <span class="text-gray-400">Sede</span>\r
          <span class="text-white ml-auto">{{ modalDetalle.partido?.equipoLocal?.sede }}</span>\r
        </div>\r
        <div class="flex items-center gap-3 bg-slate-800/50 rounded-lg px-4 py-3">\r
          <i class="fas fa-futbol text-green-400 w-4"></i>\r
          <span class="text-gray-400">Resultado</span>\r
          <span class="text-white ml-auto font-bold text-lg">\r
            {{ modalDetalle.partido?.golesLocal }} - {{ modalDetalle.partido?.golesVisitante }}\r
          </span>\r
        </div>\r
      </div>\r
\r
      <div class="mt-5">\r
        <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">\r
          <i class="fas fa-list mr-1"></i>Eventos del partido\r
        </p>\r
        <div *ngIf="cargandoEventos" class="text-center py-3 text-gray-500 text-sm">\r
          Cargando eventos...\r
        </div>\r
        <div *ngIf="!cargandoEventos && eventosDetalle.length === 0" class="text-center py-3 text-gray-600 text-sm">\r
          Sin eventos registrados\r
        </div>\r
        <div class="space-y-2">\r
          <div *ngFor="let evento of eventosDetalle"\r
               class="flex items-center gap-3 bg-slate-800/50 rounded-lg px-4 py-2 text-sm">\r
            <i [class]="getIconoEvento(evento.tipoEvento)"></i>\r
            <span class="text-white font-semibold">{{ evento.nombreJugador }}</span>\r
            <span class="text-gray-500 ml-auto">min. {{ evento.minuto }}</span>\r
          </div>\r
        </div>\r
      </div>\r
\r
      <button (click)="cerrarDetalle()"\r
              class="w-full mt-6 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-lg border border-slate-600 transition-all">\r
        Cerrar\r
      </button>\r
    </div>\r
  </div>\r
\r
</div>\r
\r
