      case "Gol":
        return "fas fa-futbol text-green-400";
      case "TarjetaAmarilla":
        return "fas fa-square text-yellow-400";
      case "TarjetaRoja":
        return "fas fa-square text-red-500";
      default:
        return "fas fa-circle text-gray-400";
    }
  }
