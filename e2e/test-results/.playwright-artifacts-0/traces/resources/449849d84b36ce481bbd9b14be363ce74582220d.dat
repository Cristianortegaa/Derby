            this.jugadoresVisitante = jugadoresVisitante;
            this.jugadores = [...jugadoresLocal, ...jugadoresVisitante];
            this.cdr.detectChanges();
          }
        });
      }
    });
  }
  cargarEventos() {
    this.arbitroService.obtenerEventos(this.partidoId).subscribe({
