(() => {
  (typeof ngDevMode === "undefined" || ngDevMode) && i015.\u0275setClassMetadata(AdminLigaDetail, [{
    type: Component11,
    args: [{ selector: "app-admin-liga-detail", standalone: true, imports: [CommonModule11, FormsModule6, RouterLink8, NavbarComponent], template: `<div class="w-full min-h-screen flex flex-col bg-gradient-to-br from-slate-950 via-slate-950 to-slate-900 text-white relative">\r
\r
  <app-navbar></app-navbar>\r
  <div class="h-20"></div>\r
\r
  <div class="absolute top-0 left-0 w-96 h-96 bg-blue-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-red-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
\r
  <div class="relative z-10 px-6 md:px-12 py-8 max-w-7xl mx-auto w-full">\r
\r
    <!-- Header -->\r
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">\r
      <div>\r
        <p class="text-gray-500 text-xs font-semibold uppercase tracking-widest mb-1">Liga</p>\r
        <h1 class="text-3xl md:text-4xl font-black mb-1 text-white">\r
          <span *ngIf="cargando">Cargando...</span>\r
          <span *ngIf="!cargando && liga">{{ liga.nombre }}</span>\r
          <span *ngIf="!cargando && !liga">Liga no encontrada</span>\r
        </h1>\r
        <div class="flex items-center gap-3 mt-2" *ngIf="liga">\r
          <span class="text-gray-500 text-sm">{{ liga.grupo }}</span>\r
          <span class="text-gray-600">\xB7</span>\r
          <span class="text-gray-500 text-sm">J{{ liga.jornadaActual }}/{{ liga.jornadas }}</span>\r
          <span class="text-gray-600">\xB7</span>\r
          <span class="badge" [ngClass]="getBadgeClase(liga.estado)">\r
            <span class="dot" [ngClass]="'dot-' + liga.estado?.toLowerCase()"></span>\r
            {{ liga.estado }}\r
          </span>\r
        </div>\r
        <div class="h-1 w-16 bg-gradient-to-r from-blue-400 to-red-400 mt-3 rounded-full"></div>\r
      </div>\r
      <div class="flex items-center gap-3">\r
        <button *ngIf="liga"\r
                (click)="generarCalendario()"\r
                [disabled]="generandoCalendario"\r
                class="px-4 py-2 bg-gradient-to-r from-green-600 to-green-700 hover:from-green-500 hover:to-green-600 disabled:opacity-50 text-white font-semibold rounded-lg text-sm">\r
          {{ generandoCalendario ? 'Generando...' : 'Generar Calendario' }}\r
        </button>\r
        <a routerLink="/admin/ligas"\r
           class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-blue-500/40 rounded-lg text-white hover:border-blue-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
          <i class="fas fa-arrow-left"></i> Volver a Ligas\r
        </a>\r
      </div>\r
    </div>\r
\r
    <!-- Loading -->\r
    <div *ngIf="cargando" class="flex flex-col items-center justify-center py-24">\r
      <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-blue-500 mb-4"></div>\r
      <p class="text-gray-500 text-sm">Cargando liga...</p>\r
    </div>\r
\r
    <!-- Not found -->\r
    <div *ngIf="!cargando && !liga" class="flex flex-col items-center justify-center py-24 text-center">\r
      <i class="fas fa-circle-xmark text-5xl text-red-500/40 mb-4"></i>\r
      <p class="text-gray-400 font-semibold text-lg">Liga no encontrada</p>\r
      <a routerLink="/admin/ligas" class="mt-4 text-blue-400 hover:text-blue-300 text-sm"><i class="fas fa-arrow-left mr-1"></i> Volver a la lista</a>\r
    </div>\r
\r
    <!-- Tarjetas -->\r
    <div *ngIf="!cargando && liga" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6">\r
\r
      <!-- Partidos -->\r
      <a [routerLink]="['/admin/partidos']" [queryParams]="{ ligaId: ligaId }"\r
         class="group bg-gradient-to-br from-green-900/40 to-green-800/20 border border-green-500/40 rounded-xl p-6 hover:border-green-400/80 hover:shadow-lg hover:shadow-green-500/20 transition-all duration-300 cursor-pointer">\r
        <div class="flex items-center gap-3 mb-3">\r
          <div class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center group-hover:bg-green-500/40 transition-colors">\r
            <i class="fas fa-futbol text-green-400 text-xl"></i>\r
          </div>\r
          <h3 class="text-lg font-bold text-white">Partidos</h3>\r
        </div>\r
        <p class="text-gray-400 text-sm">Gestiona los partidos de esta liga</p>\r
        <div class="mt-4 flex items-center gap-1 text-green-400/70 text-xs font-semibold group-hover:text-green-400 transition-colors">\r
          Ir a Partidos <i class="fas fa-arrow-right text-xs"></i>\r
        </div>\r
      </a>\r
\r
      <!-- Clasificaci\xF3n -->\r
      <a [routerLink]="['/admin/clasificacion']" [queryParams]="{ ligaId: ligaId }"\r
         class="group bg-gradient-to-br from-pink-900/40 to-pink-800/20 border border-pink-500/40 rounded-xl p-6 hover:border-pink-400/80 hover:shadow-lg hover:shadow-pink-500/20 transition-all duration-300 cursor-pointer">\r
        <div class="flex items-center gap-3 mb-3">\r
          <div class="w-12 h-12 bg-pink-500/20 rounded-lg flex items-center justify-center group-hover:bg-pink-500/40 transition-colors">\r
            <i class="fas fa-table text-pink-400 text-xl"></i>\r
          </div>\r
          <h3 class="text-lg font-bold text-white">Clasificaci\xF3n</h3>\r
        </div>\r
        <p class="text-gray-400 text-sm">Tabla de posiciones de esta liga</p>\r
        <div class="mt-4 flex items-center gap-1 text-pink-400/70 text-xs font-semibold group-hover:text-pink-400 transition-colors">\r
          Ir a Clasificaci\xF3n <i class="fas fa-arrow-right text-xs"></i>\r
        </div>\r
      </a>\r
\r
      <!-- Calendario -->\r
      <a [routerLink]="['/admin/calendario']" [queryParams]="{ ligaId: ligaId }"\r
         class="group bg-gradient-to-br from-cyan-900/40 to-cyan-800/20 border border-cyan-500/40 rounded-xl p-6 hover:border-cyan-400/80 hover:shadow-lg hover:shadow-cyan-500/20 transition-all duration-300 cursor-pointer">\r
        <div class="flex items-center gap-3 mb-3">\r
          <div class="w-12 h-12 bg-cyan-500/20 rounded-lg flex items-center justify-center group-hover:bg-cyan-500/40 transition-colors">\r
            <i class="fas fa-calendar-days text-cyan-400 text-xl"></i>\r
          </div>\r
          <h3 class="text-lg font-bold text-white">Calendario</h3>\r
        </div>\r
        <p class="text-gray-400 text-sm">Calendario de partidos por jornada de esta liga</p>\r
        <div class="mt-4 flex items-center gap-1 text-cyan-400/70 text-xs font-semibold group-hover:text-cyan-400 transition-colors">\r
          Ir a Calendario <i class="fas fa-arrow-right text-xs"></i>\r
        </div>\r
      </a>\r
\r
      <!-- Goleadores -->\r
      <a [routerLink]="['/admin/goleadores']" [queryParams]="{ ligaId: ligaId }"\r
         class="group bg-gradient-to-br from-orange-900/40 to-orange-800/20 border border-orange-500/40 rounded-xl p-6 hover:border-orange-400/80 hover:shadow-lg hover:shadow-orange-500/20 transition-all duration-300 cursor-pointer">\r
        <div class="flex items-center gap-3 mb-3">\r
          <div class="w-12 h-12 bg-orange-500/20 rounded-lg flex items-center justify-center group-hover:bg-orange-500/40 transition-colors">\r
            <i class="fas fa-ranking-star text-orange-400 text-xl"></i>\r
          </div>\r
          <h3 class="text-lg font-bold text-white">Goleadores</h3>\r
        </div>\r
        <p class="text-gray-400 text-sm">Ranking de goleadores de esta liga</p>\r
        <div class="mt-4 flex items-center gap-1 text-orange-400/70 text-xs font-semibold group-hover:text-orange-400 transition-colors">\r
          Ir a Goleadores <i class="fas fa-arrow-right text-xs"></i>\r
        </div>\r
      </a>\r
\r
    </div>\r
    <div class="mt-10" *ngIf="!cargando && liga">\r
\r
      <h2 class="text-xl font-bold text-white mb-1">Equipos de la liga</h2>\r
      <p class="text-gray-500 text-sm mb-6">{{ equiposLiga.length }} equipo(s) inscritos</p>\r
\r
      <div class="flex flex-wrap gap-3 mb-6">\r
        <input type="text" [(ngModel)]="filtroEquipo" placeholder="Buscar equipo..."\r
               class="px-3 py-2 bg-slate-900/80 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 outline-none w-52"/>\r
        <select [(ngModel)]="equipoSeleccionado"\r
                class="px-3 py-2 bg-slate-900/80 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 outline-none">\r
          <option [ngValue]="0">Seleccionar equipo...</option>\r
          <option *ngFor="let e of equiposFiltrados" [ngValue]="e.id">{{ e.nombre }}</option>\r
        </select>\r
        <button (click)="agregarEquipo()"\r
                class="px-4 py-2 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-500 hover:to-blue-600 text-white font-semibold rounded-lg text-sm">\r
          + A\xF1adir equipo\r
        </button>\r
      </div>\r
\r
      <div *ngIf="equiposLiga.length === 0" class="text-gray-500 text-sm py-4">\r
        No hay equipos en esta liga todav\xEDa.\r
      </div>\r
\r
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">\r
        <div *ngFor="let equipo of equiposLiga"\r
             class="flex items-center justify-between bg-slate-900/80 border border-slate-700/50 rounded-xl px-4 py-3">\r
          <span class="text-white font-semibold text-sm">{{ equipo.nombre }}</span>\r
          <button (click)="quitarEquipo(equipo.id)"\r
                  class="text-red-400 hover:text-red-300 text-xs border border-red-500/30 rounded px-2 py-1 hover:bg-red-500/10">\r
            Quitar\r
          </button>\r
        </div>\r
      </div>\r
\r
    </div>\r
\r
  <!-- Modal confirmaci\xF3n -->\r
  <div *ngIf="modalConfirm.mostrar"\r
       class="fixed inset-0 z-50 flex items-center justify-center p-4"\r
       (click)="cerrarConfirm()">\r
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>\r
    <div class="relative z-10 w-full max-w-md bg-slate-900 rounded-2xl p-6 shadow-2xl"\r
         [ngClass]="modalConfirm.tipo === 'success' ? 'border border-green-500/30' : 'border border-red-500/30'"\r
         (click)="$event.stopPropagation()">\r
      <div class="flex items-center justify-center w-14 h-14 rounded-full mx-auto mb-5"\r
           [ngClass]="modalConfirm.tipo === 'success' ? 'bg-green-500/15 border border-green-500/30' : 'bg-red-500/15 border border-red-500/30'">\r
        <i class="text-xl"\r
           [ngClass]="modalConfirm.tipo === 'success' ? 'fas fa-check text-green-400' : 'fas fa-triangle-exclamation text-red-400'"></i>\r
      </div>\r
      <h3 class="text-lg font-bold text-white text-center mb-2">{{ modalConfirm.titulo }}</h3>\r
      <p class="text-gray-400 text-sm text-center leading-relaxed mb-6">{{ modalConfirm.mensaje }}</p>\r
      <div class="flex gap-3">\r
        <button (click)="cerrarConfirm()" class="flex-1 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-lg border border-slate-600 transition-all">\r
          Cancelar\r
        </button>\r
        <button (click)="confirmar()" class="flex-1 px-4 py-2 text-white font-semibold rounded-lg transition-all"\r
                [ngClass]="modalConfirm.tipo === 'success' ? 'bg-gradient-to-r from-green-600 to-green-700 hover:from-green-500 hover:to-green-600' : 'bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600'">\r
          {{ modalConfirm.textoConfirmar }}\r
        </button>\r
      </div>\r
    </div>\r
  </div>\r
\r
</div>\r
