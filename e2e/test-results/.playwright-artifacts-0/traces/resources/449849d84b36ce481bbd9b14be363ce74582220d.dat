      this.formulario = {
        nombre: liga.nombre,
        competicionId: liga.competicionId,
        grupo: liga.grupo || "\xDAnico",
        jornadas: liga.jornadas,
        jornadaActual: liga.jornadaActual || 0,
        estado: liga.estado
      };
