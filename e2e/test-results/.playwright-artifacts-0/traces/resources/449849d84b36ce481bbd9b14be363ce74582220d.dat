ient(\n      135deg,\n      #dc2626,\n      #b91c1c);\n  transform: scale(1.02);\n}\n.btn-secondary {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.375rem;\n  padding: 0.5rem 1rem;\n  background: rgba(30, 41, 59, 0.8);\n  color: #e2e8f0;\n  font-size: 0.8125rem;\n  font-weight: 600;\n  border-radius: 0.5rem;\n  border: 0.5px solid rgba(100, 116, 139, 0.4);\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n.btn-secondary:hover {\n  border-color: rgba(100, 116, 139, 0.7);\n  background: rgba(30, 41, 59, 1);\n}\n.action-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 2rem;\n  height: 2rem;\n  border-radius: 0.4rem;\n  border: 0.5px solid;\n  cursor: pointer;\n  background: transparent;\n  transition: all 0.15s ease;\n}\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.3rem;\n  padding: 0.2rem 0.65rem;\n  border-radius: 9999px;\n  font-size: 0.6875rem;\n  font-weight: 700;\n}\n.badge-activo {\n  background: rgba(34, 197, 94, 0.15);\n  color: #86efac;\n}\n.badge-inactivo {\n  background: rgba(100, 116, 139, 0.2);\n  color: #94a3b8;\n}\n.badge-pausado {\n  background: rgba(245, 158, 11, 0.15);\n  color: #fcd34d;\n}\n.badge-finalizado {\n  background: rgba(107, 114, 128, 0.15);\n  color: #9ca3af;\n}\n.dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  display: inline-block;\n}\n.dot-activo {\n  background: #22c55e;\n}\n.dot-inactivo {\n  background: #64748b;\n}\n.dot-pausado {\n  background: #f59e0b;\n}\n.dot-finalizado {\n  background: #6b7280;\n}\n.chip {\n  display: inline-flex;\n  align-items: center;\n  background: rgba(30, 41, 59, 0.8);\n  border: 0.5px solid rgba(100, 116, 139, 0.3);\n  border-radius: 9999px;\n  padding: 0.15rem 0.65rem;\n  font-size: 0.6875rem;\n  color: #94a3b8;\n  font-weight: 500;\n}\n.filter-select {\n  padding: 0.35rem 0.6rem;\n  background: rgba(2, 6, 23, 0.6);\n  border: 0.5px solid rgba(59, 130, 246, 0.3);\n  border-radius: 0.5rem;\n  color: #fff;\n  font-size: 0.7rem;\n  outline: none;\n  cursor: pointer;\n  width: 200px;\n}\n.filter-select option {\n  background: #0f172a;\n  color: #fff;\n}\n.filter-select:focus {\n  border-color: rgba(59, 130, 246, 0.7);\n}\n/*# sourceMappingURL=admin-ligas.css.map */\n"] }]
