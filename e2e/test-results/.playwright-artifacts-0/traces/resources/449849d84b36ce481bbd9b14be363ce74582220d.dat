\r
  <app-navbar></app-navbar>\r
  <div class="h-20"></div>\r
\r
  <div class="absolute top-0 left-0 w-96 h-96 bg-blue-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-red-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
\r
  <div class="relative z-10 px-6 md:px-12 py-8 max-w-7xl mx-auto w-full">\r
\r
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">\r
      <div>\r
        <h1 class="text-3xl md:text-4xl font-black mb-1 text-white">Actas</h1>\r
        <p class="text-gray-500 text-sm font-medium">Partidos finalizados \u2014 edita el resultado si hay alg\xFAn error</p>\r
        <div class="h-1 w-16 bg-gradient-to-r from-red-400 to-blue-400 mt-3 rounded-full"></div>\r
      </div>\r
      <a routerLink="/admin" class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-blue-500/40 rounded-lg text-white hover:border-blue-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
        <i class="fas fa-arrow-left"></i> Volver\r
      </a>\r
    </div>\r
\r
    <div class="bg-slate-900/80 border border-blue-500/20 rounded-xl p-6">\r
\r
      <div *ngIf="cargando" class="text-center py-8">\r
        <p class="text-gray-400">Cargando actas...</p>\r
      </div>\r
\r
      <div *ngIf="!cargando && actas.length === 0" class="text-center py-8">\r
        <i class="fas fa-inbox text-4xl text-gray-600 mb-3"></i>\r
        <p class="text-gray-400">No hay partidos finalizados</p>\r
      </div>\r
\r
      <div *ngIf="!cargando && actas.length > 0" class="overflow-x-auto">\r
        <table class="w-full">\r
          <thead>\r
          <tr class="border-b border-slate-700/50">\r
            <th class="text-left py-3 px-4 text-blue-400 font-bold">Liga</th>\r
            <th class="text-left py-3 px-4 text-yellow-400 font-bold">Jornada</th>\r
            <th class="text-left py-3 px-4 text-white font-bold">Local</th>\r
            <th class="text-center py-3 px-4 text-green-400 font-bold">Resultado</th>\r
            <th class="text-left py-3 px-4 text-white font-bold">Visitante</th>\r
            <th class="text-left py-3 px-4 text-gray-400 font-bold">\xC1rbitro</th>\r
            <th class="text-left py-3 px-4 text-gray-400 font-bold">Fecha</th>\r
            <th class="text-center py-3 px-4 text-red-400 font-bold">Acciones</th>\r
          </tr>\r
          </thead>\r
          <tbody>\r
          <tr *ngFor="let acta of actas" class="border-b border-slate-700/30 hover:bg-slate-800/50">\r
            <td class="py-3 px-4 text-gray-400">{{ acta.liga?.nombre || 'N/A' }}</td>\r
            <td class="py-3 px-4 text-yellow-400 font-bold">J{{ acta.jornada }}</td>\r
            <td class="py-3 px-4 text-white font-semibold">{{ acta.equipoLocal?.nombre || 'N/A' }}</td>\r
            <td class="py-3 px-4 text-center text-green-400 font-bold text-lg">{{ acta.golesLocal }} - {{ acta.golesVisitante }}</td>\r
            <td class="py-3 px-4 text-white font-semibold">{{ acta.equipoVisitante?.nombre || 'N/A' }}</td>\r
            <td class="py-3 px-4 text-gray-400 text-sm">{{ acta.arbitro ? acta.arbitro.nombre + ' ' + acta.arbitro.apellidos : 'Sin \xE1rbitro' }}</td>\r
            <td class="py-3 px-4 text-gray-400 text-sm">{{ acta.fechaHora ? (acta.fechaHora | date:'dd/MM/yyyy HH:mm') : 'Sin fecha' }}</td>\r
            <td class="py-3 px-4 text-center">\r
              <button (click)="abrirEditar(acta)" class="px-3 py-1 text-blue-300 border border-blue-500/40 rounded hover:bg-blue-500/20 text-xs">\r
                <i class="fas fa-edit"></i> Editar\r
              </button>\r
            </td>\r
          </tr>\r
          </tbody>\r
        </table>\r
      </div>\r
    </div>\r
  </div>\r
\r
  <!-- Modal editar -->\r
  <div *ngIf="editando" class="fixed inset-0 z-50 flex items-center justify-center p-4" (click)="cerrarEditar()">\r
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>\r
    <div class="relative z-10 w-full max-w-sm bg-slate-900 rounded-2xl border border-blue-500/30 p-6 shadow-2xl overflow-y-auto max-h-[90vh]" (click)="$event.stopPropagation()">\r
      <h3 class="text-lg font-bold text-white mb-1">Editar Acta</h3>\r
      <p class="text-gray-400 text-sm mb-4">{{ editando.equipoLocal?.nombre }} vs {{ editando.equipoVisitante?.nombre }}</p>\r
\r
      <!-- Eventos del partido -->\r
      <div class="mb-5">\r
        <p class="text-xs text-gray-500 font-semibold uppercase mb-2">Eventos del partido</p>\r
        <div *ngIf="eventos.length === 0" class="text-gray-500 text-sm text-center py-2">Sin eventos registrados</div>\r
        <div class="space-y-1 max-h-40 overflow-y-auto">\r
          <div *ngFor="let evento of eventos" class="flex items-center gap-3 px-3 py-2 bg-slate-800/60 rounded-lg text-sm">\r
            <span class="text-gray-400 w-8 text-center font-bold">{{ evento.minuto }}'</span>\r
            <i class="w-4 text-center"\r
               [ngClass]="{\r
                 'fas fa-futbol text-green-400': evento.tipoEvento === 'Gol',\r
                 'fas fa-square text-yellow-400': evento.tipoEvento === 'TarjetaAmarilla',\r
                 'fas fa-square text-red-500': evento.tipoEvento === 'TarjetaRoja'\r
               }"></i>\r
            <span class="text-white flex-1">{{ evento.jugador?.nombre }}</span>\r
            <span class="text-gray-500 text-xs">{{ evento.tipoEvento }}</span>\r
          </div>\r
        </div>\r
      </div>\r
\r
      <div class="flex items-center gap-4 justify-center mb-6">\r
        <div class="text-center">\r
          <p class="text-xs text-gray-400 mb-1">{{ editando.equipoLocal?.nombre }}</p>\r
          <input type="number" [(ngModel)]="formulario.golesLocal" min="0"\r
                 class="w-16 text-center text-2xl font-black bg-slate-800 border border-blue-500/40 rounded-lg text-white py-2 outline-none focus:border-blue-400"/>\r
        </div>\r
        <span class="text-2xl font-black text-gray-500">-</span>\r
        <div class="text-center">\r
          <p class="text-xs text-gray-400 mb-1">{{ editando.equipoVisitante?.nombre }}</p>\r
          <input type="number" [(ngModel)]="formulario.golesVisitante" min="0"\r
