\r
  <app-navbar></app-navbar>\r
  <div class="h-20"></div>\r
\r
  <div class="absolute top-0 left-0 w-96 h-96 bg-blue-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-red-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
\r
  <div class="relative z-10 px-6 md:px-12 py-8 max-w-7xl mx-auto w-full">\r
\r
    <!-- Header -->\r
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">\r
      <div>\r
        <p class="text-gray-500 text-xs font-semibold uppercase tracking-widest mb-1">Equipo</p>\r
        <h1 class="text-3xl md:text-4xl font-black mb-1 text-white">\r
          <span *ngIf="cargando">Cargando...</span>\r
          <span *ngIf="!cargando && equipo">{{ equipo.nombre }}</span>\r
          <span *ngIf="!cargando && !equipo">Equipo no encontrado</span>\r
        </h1>\r
        <div *ngIf="equipo" class="flex items-center gap-3 mt-2">\r
          <span class="text-gray-500 text-sm"><i class="fas fa-location-dot mr-1"></i>{{ equipo.sede }}</span>\r
          <span *ngIf="equipo.entrenador" class="text-gray-500 text-sm"><i class="fas fa-user-tie mr-1"></i>{{ equipo.entrenador }}</span>\r
        </div>\r
        <div class="h-1 w-16 bg-gradient-to-r from-blue-400 to-red-400 mt-3 rounded-full"></div>\r
      </div>\r
      <div class="flex items-center gap-3">\r
        <button *ngIf="equipo && !editandoEquipo" (click)="abrirEditarEquipo()"\r
                class="px-4 py-2 bg-slate-900/80 border border-blue-500/40 rounded-lg text-white hover:border-blue-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
          <i class="fas fa-edit mr-2"></i>Editar equipo\r
        </button>\r
        <a routerLink="/admin/equipos"\r
           class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-blue-500/40 rounded-lg text-white hover:border-blue-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
          <i class="fas fa-arrow-left"></i> Volver a Equipos\r
        </a>\r
      </div>\r
    </div>\r
\r
    <!-- Loading -->\r
    <div *ngIf="cargando" class="flex flex-col items-center justify-center py-24">\r
      <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-blue-500 mb-4"></div>\r
      <p class="text-gray-500 text-sm">Cargando equipo...</p>\r
    </div>\r
\r
    <!-- Not found -->\r
    <div *ngIf="!cargando && !equipo" class="flex flex-col items-center justify-center py-24 text-center">\r
      <i class="fas fa-circle-xmark text-5xl text-red-500/40 mb-4"></i>\r
      <p class="text-gray-400 font-semibold text-lg">Equipo no encontrado</p>\r
      <a routerLink="/admin/equipos" class="mt-4 text-blue-400 hover:text-blue-300 text-sm"><i class="fas fa-arrow-left mr-1"></i> Volver a la lista</a>\r
    </div>\r
\r
    <!-- Formulario editar equipo -->\r
    <div *ngIf="editandoEquipo" class="bg-slate-900/80 border border-blue-500/30 rounded-xl p-6 mb-6">\r
      <h2 class="text-lg font-bold text-blue-400 mb-4"><i class="fas fa-pen-to-square mr-2"></i>Editar Equipo</h2>\r
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">\r
        <input type="text" [(ngModel)]="formularioEquipo.nombre" placeholder="Nombre del equipo"\r
               class="px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 focus:outline-none"/>\r
        <input type="text" [(ngModel)]="formularioEquipo.sede" placeholder="Sede"\r
               class="px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 focus:outline-none"/>\r
        <input type="text" [(ngModel)]="formularioEquipo.entrenador" placeholder="Entrenador"\r
               class="px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 focus:outline-none"/>\r
      </div>\r
      <div class="flex gap-3">\r
        <button (click)="guardarEquipo()"\r
                class="px-6 py-2 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-500 hover:to-blue-600 text-white font-semibold rounded-lg transition-all">\r
          <i class="fas fa-save mr-2"></i>Guardar\r
        </button>\r
        <button (click)="cerrarEditarEquipo()"\r
                class="px-6 py-2 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-lg border border-slate-600 transition-all">\r
          Cancelar\r
        </button>\r
      </div>\r
    </div>\r
\r
    <!-- Jugadores -->\r
    <div *ngIf="!cargando && equipo" class="bg-slate-900/80 border border-blue-500/20 rounded-xl p-6">\r
      <div class="flex items-center justify-between mb-6">\r
        <div>\r
          <h2 class="text-lg font-bold text-white"><i class="fas fa-users mr-2"></i>Jugadores</h2>\r
          <p class="text-gray-500 text-sm mt-1">{{ jugadores.length }}/25 jugadores</p>\r
        </div>\r
        <button *ngIf="jugadores.length < 25 && !mostrarFormJugador" (click)="abrirFormJugador()"\r
                class="px-4 py-2 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-500 hover:to-blue-600 text-white font-semibold rounded-lg text-sm">\r
          <i class="fas fa-plus mr-2"></i>A\xF1adir jugador\r
        </button>\r
      </div>\r
\r
      <!-- Formulario jugador -->\r
      <div *ngIf="mostrarFormJugador" class="bg-slate-950/50 border border-slate-700/50 rounded-lg p-4 mb-4">\r
        <h3 class="text-sm font-bold text-white mb-3">{{ editandoJugadorId ? 'Editar jugador' : 'Nuevo jugador' }}</h3>\r
        <div class="flex items-center gap-3">\r
          <input type="text" [(ngModel)]="formularioJugador.nombre" placeholder="Nombre del jugador"\r
                 class="flex-1 px-3 py-2 bg-slate-900/80 border border-slate-700/50 rounded-lg text-white text-sm focus:border-blue-400 focus:outline-none"/>\r
          <input type="number" [(ngModel)]="formularioJugador.dorsal" placeholder="Dorsal" min="1" max="99"\r
                 class="w-24 px-3 py-2 bg-slate-900/80 border border-slate-700/50 rounded-lg text-white text-sm focus:border-blue-400 focus:outline-none"/>\r
          <button (click)="guardarJugador()"\r
                  class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-lg text-sm">\r
            <i class="fas fa-check mr-1"></i>Guardar\r
          </button>\r
          <button (click)="cerrarFormJugador()"\r
                  class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-lg text-sm border border-slate-600">\r
            Cancelar\r
          </button>\r
        </div>\r
      </div>\r
\r
      <!-- Lista jugadores -->\r
      <div *ngIf="jugadores.length === 0" class="text-center py-8">\r
        <i class="fas fa-inbox text-4xl text-gray-600 mb-3"></i>\r
        <p class="text-gray-400">No hay jugadores en este equipo</p>\r
      </div>\r
\r
      <div *ngIf="jugadores.length > 0" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">\r
        <div *ngFor="let jugador of jugadores"\r
             class="flex items-center justify-between bg-slate-950/50 border border-slate-700/50 rounded-lg px-4 py-3">\r
          <div class="flex items-center gap-3">\r
            <span class="w-8 h-8 flex items-center justify-center bg-blue-500/20 text-blue-400 font-bold text-sm rounded-lg">\r
              {{ jugador.dorsal }}\r
            </span>\r
            <span class="text-white font-semibold text-sm">{{ jugador.nombre }}</span>\r
          </div>\r
          <div class="flex items-center gap-2">\r
            <button (click)="abrirFormJugador(jugador)" class="text-blue-400 hover:text-blue-300 text-xs">\r
              <i class="fas fa-edit"></i>\r
            </button>\r
            <button (click)="eliminarJugador(jugador.id)" class="text-red-400 hover:text-red-300 text-xs">\r
              <i class="fas fa-trash"></i>\r
            </button>\r
          </div>\r
        </div>\r
      </div>\r
    </div>\r
\r
  </div>\r
\r
  <!-- Notificacion -->\r
  <div *ngIf="notificacion.mostrar"\r
       class="fixed bottom-6 right-6 z-50 px-5 py-3 rounded-xl text-sm font-semibold shadow-2xl"\r
       [ngClass]="notificacion.tipo === 'exito' ? 'bg-green-500/90 text-white' : 'bg-red-500/90 text-white'">\r
    {{ notificacion.mensaje }}\r
  </div>\r
\r
  <!-- Modal confirmacion -->\r
  <div *ngIf="modalConfirm.mostrar"\r
       class="fixed inset-0 z-50 flex items-center justify-center p-4"\r
       (click)="cerrarConfirm()">\r
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>\r
    <div class="relative z-10 w-full max-w-md bg-slate-900 rounded-2xl border border-red-500/30 p-6 shadow-2xl"\r
         (click)="$event.stopPropagation()">\r
      <div class="flex items-center justify-center w-14 h-14 rounded-full bg-red-500/15 border border-red-500/30 mx-auto mb-5">\r
        <i class="fas fa-triangle-exclamation text-red-400 text-xl"></i>\r
      </div>\r
      <h3 class="text-lg font-bold text-white text-center mb-2">{{ modalConfirm.titulo }}</h3>\r
      <p class="text-gray-400 text-sm text-center leading-relaxed mb-6">{{ modalConfirm.mensaje }}</p>\r
      <div class="flex gap-3">\r
        <button (click)="cerrarConfirm()" class="flex-1 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-lg border border-slate-600 transition-all">\r
          Cancelar\r
        </button>\r
        <button (click)="confirmar()" class="flex-1 px-4 py-2 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-semibold rounded-lg transition-all">\r
          <i class="fas fa-trash text-xs mr-1"></i> {{ modalConfirm.textoConfirmar }}\r
        </button>\r
      </div>\r
    </div>\r
  </div>\r
\r
</div>\r
` }]
