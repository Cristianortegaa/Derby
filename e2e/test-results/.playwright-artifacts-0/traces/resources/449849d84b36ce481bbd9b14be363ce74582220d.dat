\r
  <app-navbar></app-navbar>\r
\r
  <div class="h-20"></div>\r
\r
  <div class="absolute top-0 left-0 w-80 h-80 bg-blue-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
  <div class="absolute bottom-0 right-0 w-80 h-80 bg-red-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
  <div class="absolute top-1/2 left-1/2 w-96 h-96 bg-blue-600 opacity-5 blur-3xl rounded-full pointer-events-none -translate-x-1/2 -translate-y-1/2"></div>\r
\r
  <div class="relative z-10 px-6 md:px-12 py-6 max-w-7xl mx-auto w-full">\r
    <h1 class="text-3xl md:text-4xl font-black mb-2 text-white mt-2">\r
      Clubes\r
    </h1>\r
    <p class="text-gray-500 text-sm md:text-base font-medium">Todos los equipos que forman parte de la comunidad Derby</p>\r
    <div class="h-1 w-16 bg-gradient-to-r from-red-400 to-blue-400 mt-3 rounded-full"></div>\r
  </div>\r
\r
  <main class="relative z-10 flex-1 px-6 md:px-12 pb-20 max-w-7xl mx-auto w-full">\r
\r
    <!-- FILTROS DE B\xDASQUEDA -->\r
    <div class="bg-slate-900/80 backdrop-blur-md border border-blue-500/40 rounded-xl p-5 shadow-lg mb-6">\r
      <h2 class="text-lg font-bold text-red-400 mb-4">\r
        <i class="fas fa-filter mr-2"></i>Filtro de B\xFAsquedas\r
      </h2>\r
\r
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-4">\r
        <!-- B\xFAsqueda por nombre -->\r
        <div>\r
          <label class="block text-white text-sm font-semibold mb-2">\r
            <span class="text-red-400">*</span> NOMBRE DEL EQUIPO\r
          </label>\r
          <input type="text" [(ngModel)]="textoBusqueda" placeholder="Buscar equipo por nombre..."\r
                 class="w-full px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 focus:outline-none transition-all placeholder:text-slate-500">\r
        </div>\r
\r
        <!-- Liga -->\r
        <div>\r
          <label class="block text-white text-sm font-semibold mb-2">\r
            <span class="text-red-400">*</span> LIGA\r
          </label>\r
          <select [(ngModel)]="filtroLiga" class="w-full px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 focus:outline-none transition-all">\r
            <option value="">Todas las ligas</option>\r
            <option *ngFor="let liga of ligas" [value]="liga">{{ liga }}</option>\r
          </select>\r
        </div>\r
      </div>\r
    </div>\r
\r
    <!-- GRID DE CLUBES -->\r
    <div class="bg-slate-900/80 backdrop-blur-md border border-blue-500/40 rounded-xl p-5 shadow-lg">\r
\r
      <div *ngIf="cargando" class="text-center py-20">\r
        <i class="fas fa-spinner animate-spin text-3xl text-blue-400 mb-3 block"></i>\r
        <p class="text-gray-400">Cargando equipos...</p>\r
      </div>\r
\r
      <div *ngIf="!cargando" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">\r
\r
        <ng-container *ngFor="let club of clubesFiltrados">\r
          <div class="group bg-slate-800/50 border border-blue-500/30 rounded-lg overflow-hidden hover:border-blue-400/60 transition-all hover:shadow-lg hover:shadow-blue-500/20">\r
            <div class="p-6">\r
              <div class="flex items-center gap-4 mb-4">\r
                <div class="w-16 h-16 bg-gradient-to-br from-red-600 to-blue-600 rounded-lg flex items-center justify-center border border-blue-400/50 group-hover:border-blue-300 overflow-hidden">\r
                  <img *ngIf="club.escudoUrl" [src]="club.escudoUrl" alt="Escudo" class="w-full h-full object-cover">\r
                  <i *ngIf="!club.escudoUrl" class="fas fa-shield-halved text-2xl text-white"></i>\r
                </div>\r
\r
                <div class="flex-1">\r
                  <h3 class="text-lg font-bold text-white">{{ club.nombre }}</h3>\r
                  <p class="text-xs text-gray-400 mt-1">\r
                    <i class="fas fa-location-dot text-red-400 mr-1"></i>{{ club.sede || 'Sin sede' }}\r
                  </p>\r
                </div>\r
              </div>\r
\r
              <div class="mb-4 pt-4 border-t border-blue-500/20">\r
                <span class="inline-block text-[11px] font-black text-blue-400 uppercase tracking-widest bg-blue-500/10 px-3 py-1 rounded-md border border-blue-500/40">\r
                  {{ club.ligaNombre || 'Sin liga' }}\r
                </span>\r
              </div>\r
\r
              <button (click)="verPlantilla(club)" class="w-full py-2 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white text-xs font-bold rounded-lg transition-all uppercase tracking-widest">\r
                <i class="fas fa-users mr-2"></i>Ver Plantilla\r
              </button>\r
            </div>\r
          </div>\r
        </ng-container>\r
\r
        <div *ngIf="clubesFiltrados.length === 0" class="col-span-full py-20 text-center">\r
          <div class="w-20 h-20 mx-auto bg-slate-800/80 rounded-full flex items-center justify-center mb-4 border border-blue-500/40">\r
            <i class="fas fa-search text-3xl text-blue-400"></i>\r
          </div>\r
          <h3 class="text-xl font-bold text-white mb-2">Ning\xFAn equipo encontrado</h3>\r
          <p class="text-gray-400">Prueba a usar otro nombre o cambiar el filtro de liga.</p>\r
        </div>\r
\r
      </div>\r
    </div>\r
  </main>\r
</div>\r
\r
<div *ngIf="modalAbierto" class="fixed inset-0 z-50 flex items-center justify-center p-4" (click)="cerrarModal()">\r
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>\r
  <div class="relative z-10 w-full max-w-lg bg-slate-900 rounded-2xl border border-blue-500/30 p-6 shadow-2xl max-h-[80vh] flex flex-col" (click)="$event.stopPropagation()">\r
\r
    <div class="flex items-center justify-between mb-5">\r
      <div class="flex items-center gap-3">\r
        <div class="w-12 h-12 bg-gradient-to-br from-red-600 to-blue-600 rounded-lg flex items-center justify-center overflow-hidden">\r
          <img *ngIf="equipoSeleccionado?.escudoUrl" [src]="equipoSeleccionado?.escudoUrl" class="w-full h-full object-cover">\r
          <i *ngIf="!equipoSeleccionado?.escudoUrl" class="fas fa-shield-halved text-white"></i>\r
        </div>\r
        <div>\r
          <h3 class="text-lg font-bold text-white">{{ equipoSeleccionado?.nombre }}</h3>\r
          <p class="text-xs text-gray-400">{{ equipoSeleccionado?.ligaNombre || 'Sin liga' }}</p>\r
          <p class="text-xs text-gray-400"><i class="fas fa-user-tie mr-1"></i>{{ equipoSeleccionado?.entrenador || 'Sin entrenador' }}</p>\r
        </div>\r
      </div>\r
      <button (click)="cerrarModal()" class="text-gray-400 hover:text-white transition">\r
        <i class="fas fa-times text-xl"></i>\r
      </button>\r
    </div>\r
\r
    <div *ngIf="cargandoJugadores" class="text-center py-8">\r
      <i class="fas fa-spinner animate-spin text-blue-400 text-2xl"></i>\r
    </div>\r
\r
    <div *ngIf="!cargandoJugadores" class="overflow-y-auto flex-1">\r
      <div *ngIf="jugadores.length === 0" class="text-center py-8 text-gray-400">\r
        <i class="fas fa-users text-3xl mb-2 block"></i>\r
        No hay jugadores registrados\r
      </div>\r
      <table *ngIf="jugadores.length > 0" class="w-full text-sm">\r
        <thead>\r
          <tr class="border-b border-slate-700 text-gray-400 text-left">\r
            <th class="py-2 px-3">Dorsal</th>\r
            <th class="py-2 px-3">Nombre</th>\r
          </tr>\r
        </thead>\r
        <tbody class="divide-y divide-slate-700/50">\r
          <tr *ngFor="let jugador of jugadores" class="hover:bg-slate-800/50">\r
            <td class="py-2 px-3 font-bold text-blue-400">{{ jugador.dorsal }}</td>\r
            <td class="py-2 px-3 text-white">{{ jugador.nombre }}</td>\r
          </tr>\r
        </tbody>\r
      </table>\r
    </div>\r
\r
  </div>\r
</div>\r
