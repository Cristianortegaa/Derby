(() => {
  (typeof ngDevMode === "undefined" || ngDevMode) && i014.\u0275setClassMetadata(AdminLigas, [{
    type: Component10,
    args: [{ selector: "app-admin-ligas", standalone: true, imports: [CommonModule10, FormsModule5, RouterLink7, NavbarComponent], template: `<div class="w-full min-h-screen flex flex-col bg-gradient-to-br from-slate-950 via-slate-950 to-slate-900 text-white relative">\r
\r
  <app-navbar></app-navbar>\r
  <div class="h-20"></div>\r
\r
  <div class="absolute top-0 left-0 w-96 h-96 bg-blue-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-red-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
\r
  <div class="relative z-10 px-6 md:px-12 py-8 max-w-7xl mx-auto w-full">\r
\r
    <!-- Header -->\r
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">\r
      <div>\r
        <h1 class="text-3xl md:text-4xl font-black mb-1 text-white">Gestionar Ligas</h1>\r
        <p class="text-gray-500 text-sm font-medium">Crea, edita y gestiona ligas, grupos y jornadas</p>\r
        <div class="h-1 w-16 bg-gradient-to-r from-blue-400 to-red-400 mt-3 rounded-full"></div>\r
      </div>\r
      <div class="flex items-center gap-3">\r
        <a *ngIf="competicionIdFijado"\r
           [routerLink]="['/admin/competiciones', competicionIdFijado]"\r
           class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-green-500/40 rounded-lg text-white hover:border-green-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
          <i class="fas fa-arrow-left"></i> Volver a Competici\xF3n\r
        </a>\r
        <a *ngIf="!competicionIdFijado" routerLink="/admin/competiciones"\r
           class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-red-500/40 rounded-lg text-white hover:border-red-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
          <i class="fas fa-trophy text-red-400 text-xs"></i> Ir a Competiciones\r
        </a>\r
        <a *ngIf="!competicionIdFijado" routerLink="/admin"\r
           class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-blue-500/40 rounded-lg text-white hover:border-blue-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
          <i class="fas fa-arrow-left"></i> Volver\r
        </a>\r
      </div>\r
    </div>\r
\r
    <!-- Stats -->\r
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-5">\r
      <div class="stat-card rounded-xl p-4">\r
        <div class="text-xs text-gray-500 font-semibold uppercase tracking-widest mb-1 flex items-center gap-2">\r
          <i class="fas fa-list text-blue-400"></i> Ligas\r
        </div>\r
        <div class="text-3xl font-black text-white">{{ ligas.length }}</div>\r
        <div class="text-xs text-gray-600 mt-1">registradas en total</div>\r
      </div>\r
      <div class="stat-card rounded-xl p-4">\r
        <div class="text-xs text-gray-500 font-semibold uppercase tracking-widest mb-1 flex items-center gap-2">\r
          <i class="fas fa-circle-check text-green-400"></i> Activas\r
        </div>\r
        <div class="text-3xl font-black text-white">{{ statActivas }}</div>\r
        <div class="text-xs text-gray-600 mt-1">en curso ahora mismo</div>\r
      </div>\r
      <div class="stat-card rounded-xl p-4">\r
        <div class="text-xs text-gray-500 font-semibold uppercase tracking-widest mb-1 flex items-center gap-2">\r
          <i class="fas fa-users text-amber-400"></i> Equipos\r
        </div>\r
        <div class="text-3xl font-black text-white">{{ statTotalEquipos }}</div>\r
        <div class="text-xs text-gray-600 mt-1">participantes totales</div>\r
      </div>\r
    </div>\r
\r
    <!-- Formulario -->\r
    <div *ngIf="mostrarForm" class="section-card rounded-xl p-8 mb-6 border border-blue-500/30">\r
      <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2">\r
        <i class="fas" [ngClass]="editandoId ? 'fa-pen-to-square' : 'fa-plus-circle'"></i>\r
        {{ editandoId ? 'Editar liga' : 'Nueva liga' }}\r
      </h2>\r
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">\r
        <div>\r
          <label class="field-label">Nombre de la liga <span class="text-red-400">*</span></label>\r
          <input type="text" [(ngModel)]="formulario.nombre" name="nombre"\r
                 placeholder="Ej: Primera Divisi\xF3n" class="field-input"/>\r
        </div>\r
        <div>\r
          <label class="field-label">Competici\xF3n <span class="text-red-400">*</span></label>\r
          <select [(ngModel)]="formulario.competicionId" name="competicionId" class="field-input">\r
            <option [value]="null" disabled>Selecciona competici\xF3n</option>\r
            <option *ngFor="let c of competiciones" [value]="c.id">{{ c.nombre }} ({{ c.temporada }})</option>\r
          </select>\r
        </div>\r
        <div>\r
          <label class="field-label">Grupo</label>\r
          <select [(ngModel)]="formulario.grupo" name="grupo" class="field-input">\r
            <option *ngFor="let g of grupos" [value]="g">{{ g }}</option>\r
          </select>\r
        </div>\r
        <div>\r
          <label class="field-label">Estado</label>\r
          <select [(ngModel)]="formulario.estado" name="estado" class="field-input">\r
            <option *ngFor="let e of estados" [value]="e">{{ e }}</option>\r
          </select>\r
        </div>\r
        <div>\r
          <label class="field-label">Jornadas totales</label>\r
          <input type="number" [(ngModel)]="formulario.jornadas" name="jornadas"\r
                 min="1" max="100" class="field-input"/>\r
        </div>\r
        <div>\r
          <label class="field-label">Jornada actual</label>\r
          <input type="number" [(ngModel)]="formulario.jornadaActual" name="jornadaActual"\r
                 min="0" [max]="formulario.jornadas" class="field-input"/>\r
        </div>\r
      </div>\r
      <div class="flex gap-3 justify-end mt-6">\r
        <button (click)="cerrarForm()" class="btn-secondary">Cancelar</button>\r
        <button (click)="guardar()" class="btn-primary">\r
          <i class="fas" [ngClass]="editandoId ? 'fa-save' : 'fa-check'"></i>\r
          {{ editandoId ? 'Actualizar' : 'Crear liga' }}\r
        </button>\r
      </div>\r
    </div>\r
\r
    <!-- Tabla -->\r
    <div class="section-card rounded-xl border border-blue-500/20">\r
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 p-6 border-b border-slate-700/50">\r
        <h2 class="text-base font-bold text-blue-400 flex items-center gap-2">\r
          <i class="fas fa-list"></i> Ligas ({{ ligasFiltradas.length }})\r
        </h2>\r
        <div class="flex flex-wrap gap-2 items-center justify-end">\r
          <div class="search-box">\r
            <i class="fas fa-search text-gray-500 text-xs"></i>\r
            <input type="text" [(ngModel)]="busquedaNombre" (input)="aplicarFiltro()"\r
                   placeholder="Buscar liga..." class="search-input"/>\r
          </div>\r
          <select *ngIf="!competicionIdFijado" [(ngModel)]="filtroCompeticion" (change)="aplicarFiltro()" class="filter-select">\r
            <option value="">Todas las competiciones</option>\r
            <option *ngFor="let c of competiciones" [value]="c.id">{{ c.nombre }}</option>\r
          </select>\r
          <select [(ngModel)]="filtroEstado" (change)="aplicarFiltro()" class="filter-select">\r
            <option value="">Todos los estados</option>\r
            <option *ngFor="let e of estados" [value]="e">{{ e }}</option>\r
          </select>\r
          <button *ngIf="busquedaNombre || filtroCompeticion || filtroEstado"\r
                  (click)="limpiarFiltros()" class="btn-secondary !py-1.5 !px-3 !text-xs">\r
            <i class="fas fa-times text-xs"></i>\r
          </button>\r
          <button *ngIf="!mostrarForm" (click)="abrirForm()" class="btn-primary">\r
            <i class="fas fa-plus text-xs"></i> Nueva liga\r
          </button>\r
        </div>\r
      </div>\r
\r
      <!-- Loading -->\r
      <div *ngIf="cargando" class="flex flex-col items-center justify-center py-16">\r
        <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-blue-500 mb-4"></div>\r
        <p class="text-gray-500 text-sm">Cargando ligas...</p>\r
      </div>\r
\r
      <!-- Empty -->\r
      <div *ngIf="!cargando && ligasFiltradas.length === 0"\r
           class="flex flex-col items-center justify-center py-16 text-center">\r
        <i class="fas fa-inbox text-4xl text-gray-600 mb-3"></i>\r
        <p class="text-gray-400 font-semibold">No hay ligas</p>\r
        <p class="text-gray-600 text-sm mt-1">\r
          {{ busquedaNombre || filtroCompeticion || filtroEstado ? 'Cambia los filtros o c' : 'C' }}rea una liga para una competici\xF3n\r
        </p>\r
      </div>\r
\r
      <!-- Tabla -->\r
      <div *ngIf="!cargando && ligasFiltradas.length > 0" class="overflow-x-auto">\r
        <table class="w-full">\r
          <thead>\r
          <tr class="border-b border-slate-700/50">\r
            <th class="th-cell text-blue-400">Liga</th>\r
            <th class="th-cell text-red-400">Competici\xF3n</th>\r
            <th class="th-cell text-gray-400">Grupo</th>\r
            <th class="th-cell text-gray-400" style="min-width:160px">Progreso</th>\r
            <th class="th-cell text-amber-400">Estado</th>\r
            <th class="th-cell text-red-400" style="text-align:center">Acciones</th>\r
          </tr>\r
          </thead>\r
          <tbody>\r
          <tr *ngFor="let liga of ligasFiltradas"\r
              class="border-b border-slate-700/30 hover:bg-slate-800/40 transition-colors">\r
            <td class="td-cell font-semibold text-white">{{ liga.nombre }}</td>\r
            <td class="td-cell text-gray-400 text-xs">{{ getNombreComp(liga.competicionId) }}</td>\r
            <td class="td-cell">\r
              <span class="chip">{{ liga.grupo || '\xDAnico' }}</span>\r
            </td>\r
            <td class="td-cell">\r
              <div class="flex items-center gap-2">\r
                <div class="flex-1 h-1.5 bg-slate-700 rounded-full overflow-hidden">\r
                  <div class="h-full bg-gradient-to-r from-blue-500 to-blue-400 rounded-full transition-all"\r
                       [style.width.%]="getProgreso(liga)"></div>\r
                </div>\r
                <span class="text-xs text-gray-500 min-w-[28px]">{{ getProgreso(liga) }}%</span>\r
              </div>\r
              <div class="text-xs text-gray-600 mt-0.5">J{{ liga.jornadaActual }}/{{ liga.jornadas }}</div>\r
            </td>\r
            <td class="td-cell">\r
              <span class="badge" [ngClass]="getBadgeClase(liga.estado)">\r
                <span class="dot" [ngClass]="'dot-' + liga.estado.toLowerCase()"></span>\r
                {{ liga.estado }}\r
              </span>\r
            </td>\r
            <td class="td-cell" style="text-align:center">\r
              <div class="flex gap-2 justify-center">\r
                <a [routerLink]="['/admin/ligas', liga.id]"\r
                   class="action-btn text-green-300 border-green-500/40 hover:bg-green-500/20"\r
                   title="Gestionar">\r
                  <i class="fas fa-arrow-right text-xs"></i>\r
                </a>\r
                <button (click)="abrirForm(liga)" class="action-btn text-blue-300 border-blue-500/40 hover:bg-blue-500/20">\r
                  <i class="fas fa-pen text-xs"></i>\r
                </button>\r
                <button (click)="eliminar(liga.id, liga.nombre)" class="action-btn text-red-300 border-red-500/40 hover:bg-red-500/20">\r
                  <i class="fas fa-trash text-xs"></i>\r
                </button>\r
              </div>\r
            </td>\r
          </tr>\r
          </tbody>\r
        </table>\r
      </div>\r
    </div>\r
  </div>\r
\r
  <!-- Modal confirmaci\xF3n -->\r
  <div *ngIf="modalConfirm.mostrar"\r
       class="fixed inset-0 z-50 flex items-center justify-center p-4"\r
       (click)="cerrarConfirm()">\r
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>\r
    <div class="relative z-10 w-full max-w-md section-card rounded-2xl border border-red-500/30 p-6 shadow-2xl"\r
         (click)="$event.stopPropagation()">\r
      <div class="flex items-center justify-center w-14 h-14 rounded-full bg-red-500/15 border border-red-500/30 mx-auto mb-5">\r
        <i class="fas fa-triangle-exclamation text-red-400 text-xl"></i>\r
      </div>\r
      <h3 class="text-lg font-bold text-white text-center mb-2">{{ modalConfirm.titulo }}</h3>\r
      <p class="text-gray-400 text-sm text-center leading-relaxed mb-6">{{ modalConfirm.mensaje }}</p>\r
      <div class="flex gap-3">\r
        <button (click)="cerrarConfirm()" class="flex-1 btn-secondary justify-center">\r
          Cancelar\r
        </button>\r
        <button (click)="confirmar()" class="flex-1 btn-primary justify-center">\r
          <i class="fas fa-trash text-xs"></i> Eliminar\r
        </button>\r
      </div>\r
    </div>\r
  </div>\r
\r
  <!-- Notificaci\xF3n -->\r
  <div *ngIf="notificacion.mostrar"\r
       class="fixed bottom-6 right-6 z-50 flex items-center gap-3 px-5 py-3 rounded-xl text-sm font-semibold shadow-2xl transition-all"\r
       [ngClass]="notificacion.tipo === 'exito'\r
         ? 'bg-green-500/90 text-white border border-green-400/50'\r
         : 'bg-red-500/90 text-white border border-red-400/50'">\r
    <i class="fas" [ngClass]="notificacion.tipo === 'exito' ? 'fa-circle-check' : 'fa-circle-xmark'"></i>\r
    {{ notificacion.mensaje }}\r
  </div>\r
\r
</div>\r
