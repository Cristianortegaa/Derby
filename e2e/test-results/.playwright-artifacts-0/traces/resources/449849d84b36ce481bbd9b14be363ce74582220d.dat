\r
  <app-navbar></app-navbar>\r
  <div class="h-20"></div>\r
\r
  <div class="absolute top-0 left-0 w-96 h-96 bg-blue-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-red-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
\r
  <div class="relative z-10 px-6 md:px-12 py-8 max-w-7xl mx-auto w-full">\r
\r
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">\r
      <div>\r
        <h1 class="text-3xl md:text-4xl font-black mb-1 text-white">Clasificaci\xF3n</h1>\r
        <p class="text-gray-500 text-sm font-medium">Posiciones actuales de las ligas</p>\r
        <div class="h-1 w-16 bg-gradient-to-r from-red-400 to-blue-400 mt-3 rounded-full"></div>\r
      </div>\r
\r
      <div class="flex items-center gap-3">\r
        <a *ngIf="ligaIdFijado"\r
           [routerLink]="['/admin/ligas', ligaIdFijado]"\r
           class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-green-500/40 rounded-lg text-white hover:border-green-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
          <i class="fas fa-arrow-left"></i> Volver a Liga\r
        </a>\r
        <a *ngIf="competicionIdFijado && !ligaIdFijado"\r
           [routerLink]="['/admin/competiciones', competicionIdFijado]"\r
           class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-green-500/40 rounded-lg text-white hover:border-green-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
          <i class="fas fa-arrow-left"></i> Volver a Competici\xF3n\r
        </a>\r
        <a *ngIf="!competicionIdFijado && !ligaIdFijado" routerLink="/admin"\r
           class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-blue-500/40 rounded-lg text-white hover:border-blue-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
          <i class="fas fa-arrow-left"></i> Volver\r
        </a>\r
      </div>\r
    </div>\r
\r
    <div class="bg-slate-900/80 border border-blue-500/20 rounded-xl p-6">\r
      <h2 class="text-lg font-bold text-red-400 mb-6"><i class="fas fa-chart-bar mr-2"></i>Tabla de Posiciones</h2>\r
\r
      <div *ngIf="cargando" class="text-center py-8">\r
        <p class="text-gray-400">Cargando clasificaci\xF3n...</p>\r
      </div>\r
\r
      <div *ngIf="!cargando && clasificaciones.length === 0" class="text-center py-8">\r
        <i class="fas fa-inbox text-4xl text-gray-600 mb-3"></i>\r
        <p class="text-gray-400">No hay datos de clasificaci\xF3n</p>\r
      </div>\r
\r
      <div *ngIf="!cargando && clasificaciones.length > 0" class="overflow-x-auto">\r
        <table class="w-full">\r
          <thead>\r
          <tr class="border-b border-slate-700/50">\r
            <th class="text-left py-3 px-4 text-yellow-400 font-bold">Pos</th>\r
            <th class="text-left py-3 px-4 text-white font-bold">Equipo</th>\r
            <th class="text-center py-3 px-4 text-blue-400 font-bold">PJ</th>\r
            <th class="text-center py-3 px-4 text-green-400 font-bold">G</th>\r
            <th class="text-center py-3 px-4 text-gray-400 font-bold">E</th>\r
            <th class="text-center py-3 px-4 text-red-400 font-bold">P</th>\r
            <th class="text-center py-3 px-4 text-purple-400 font-bold">GF</th>\r
            <th class="text-center py-3 px-4 text-orange-400 font-bold">GC</th>\r
            <th class="text-center py-3 px-4 text-yellow-400 font-bold">DG</th>\r
            <th class="text-center py-3 px-4 text-pink-400 font-bold">Pts</th>\r
          </tr>\r
          </thead>\r
          <tbody>\r
          <tr *ngFor="let equipo of clasificaciones; let i = index" class="border-b border-slate-700/30 hover:bg-slate-800/50">\r
            <td class="py-3 px-4 font-bold text-yellow-400">{{ i + 1 }}</td>\r
            <td class="py-3 px-4 text-white font-semibold">{{ equipo.nombre }}</td>\r
            <td class="py-3 px-4 text-center text-blue-400">{{ equipo.partidosJugados || 0 }}</td>\r
            <td class="py-3 px-4 text-center text-green-400 font-bold">{{ equipo.ganancias || 0 }}</td>\r
            <td class="py-3 px-4 text-center text-gray-400">{{ equipo.empates || 0 }}</td>\r
            <td class="py-3 px-4 text-center text-red-400">{{ equipo.derrotas || 0 }}</td>\r
            <td class="py-3 px-4 text-center text-purple-400">{{ equipo.golesAFavor || 0 }}</td>\r
            <td class="py-3 px-4 text-center text-orange-400">{{ equipo.golesEnContra || 0 }}</td>\r
            <td class="py-3 px-4 text-center text-yellow-400">{{ (equipo.golesAFavor || 0) - (equipo.golesEnContra || 0) }}</td>\r
            <td class="py-3 px-4 text-center text-pink-400 font-bold text-lg">{{ equipo.puntos || 0 }}</td>\r
          </tr>\r
          </tbody>\r
        </table>\r
      </div>\r
    </div>\r
\r
  </div>\r
\r
</div>\r
\r
