\r
  <!-- Blobs decorativos -->\r
  <div class="absolute top-0 left-0 w-96 h-96 bg-blue-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-red-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
\r
  <div class="relative z-10 px-6 md:px-12 py-8 max-w-7xl mx-auto w-full">\r
\r
    <!-- Header -->\r
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">\r
      <div>\r
        <h1 class="text-3xl md:text-4xl font-black mb-1 text-white">Gestionar Competiciones</h1>\r
        <p class="text-gray-500 text-sm font-medium">Crea, edita y gestiona competiciones y temporadas</p>\r
        <div class="h-1 w-16 bg-gradient-to-r from-red-400 to-blue-400 mt-3 rounded-full"></div>\r
      </div>\r
\r
      <div class="flex items-center gap-3">\r
        <a routerLink="/admin"\r
           class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-blue-500/40 rounded-lg text-white hover:border-blue-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
          <i class="fas fa-arrow-left"></i> Volver\r
        </a>\r
      </div>\r
    </div>\r
\r
    <!-- Stats -->\r
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-5">\r
      <div class="stat-card rounded-xl p-4">\r
        <div class="text-xs text-gray-500 font-semibold uppercase tracking-widest mb-1 flex items-center gap-2">\r
          <i class="fas fa-trophy text-red-400"></i> Competiciones\r
        </div>\r
        <div class="text-3xl font-black text-white">{{ competiciones.length }}</div>\r
        <div class="text-xs text-gray-600 mt-1">totales en el sistema</div>\r
      </div>\r
      <div class="stat-card rounded-xl p-4">\r
        <div class="text-xs text-gray-500 font-semibold uppercase tracking-widest mb-1 flex items-center gap-2">\r
          <i class="fas fa-circle-check text-green-400"></i> Activas\r
        </div>\r
        <div class="text-3xl font-black text-white">{{ statActivas }}</div>\r
        <div class="text-xs text-gray-600 mt-1">en curso ahora mismo</div>\r
      </div>\r
      <div class="stat-card rounded-xl p-4">\r
        <div class="text-xs text-gray-500 font-semibold uppercase tracking-widest mb-1 flex items-center gap-2">\r
          <i class="fas fa-circle-xmark text-gray-400"></i> Inactivas\r
        </div>\r
        <div class="text-3xl font-black text-white">{{ competiciones.length - statActivas }}</div>\r
        <div class="text-xs text-gray-600 mt-1">pausadas o finalizadas</div>\r
      </div>\r
    </div>\r
\r
    <!-- Formulario -->\r
    <div *ngIf="mostrarFormComp"\r
         class="section-card rounded-xl p-8 mb-6 border border-blue-500/30">\r
      <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2">\r
        <i class="fas" [ngClass]="editandoCompId ? 'fa-pen-to-square' : 'fa-plus-circle'"></i>\r
        {{ editandoCompId ? 'Editar competici\xF3n' : 'Nueva competici\xF3n' }}\r
      </h2>\r
\r
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">\r
        <div>\r
          <label class="field-label">Nombre <span class="text-red-400">*</span></label>\r
          <input type="text" [(ngModel)]="formularioComp.nombre" name="nombre"\r
                 placeholder="Ej: Copa RFEF Fase Auton\xF3mica" class="field-input"/>\r
        </div>\r
        <div>\r
          <label class="field-label">Temporada <span class="text-red-400">*</span></label>\r
          <input type="text" [(ngModel)]="formularioComp.temporada" name="temporada"\r
                 placeholder="Ej: 2025-2026" class="field-input"/>\r
        </div>\r
        <div>\r
          <label class="field-label">Tipo de competici\xF3n</label>\r
          <select [(ngModel)]="formularioComp.tipo" name="tipo" class="field-input">\r
            <option *ngFor="let t of tipos" [value]="t">{{ t }}</option>\r
          </select>\r
        </div>\r
        <div>\r
          <label class="field-label">Tipo de juego</label>\r
          <select [(ngModel)]="formularioComp.tipoJuego" name="tipoJuego" class="field-input">\r
            <option *ngFor="let tj of tiposJuego" [value]="tj">{{ tj }}</option>\r
          </select>\r
        </div>\r
        <div>\r
          <label class="field-label">Estado</label>\r
          <select [(ngModel)]="formularioComp.estado" name="estado" class="field-input">\r
            <option *ngFor="let e of estados" [value]="e">{{ e }}</option>\r
          </select>\r
        </div>\r
        <div>\r
          <label class="field-label">Descripci\xF3n</label>\r
          <input type="text" [(ngModel)]="formularioComp.descripcion" name="descripcion"\r
                 placeholder="Descripci\xF3n opcional..." class="field-input"/>\r
        </div>\r
      </div>\r
\r
      <div class="flex gap-3 justify-end mt-6">\r
        <button (click)="cerrarForm()" class="btn-secondary">Cancelar</button>\r
        <button (click)="guardarComp()" class="btn-primary">\r
          <i class="fas" [ngClass]="editandoCompId ? 'fa-save' : 'fa-check'"></i>\r
          {{ editandoCompId ? 'Actualizar' : 'Crear' }}\r
        </button>\r
      </div>\r
    </div>\r
\r
    <!-- Tabla -->\r
    <div class="section-card rounded-xl border border-blue-500/20">\r
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 p-6 border-b border-slate-700/50">\r
        <h2 class="text-base font-bold text-red-400 flex items-center gap-2">\r
          <i class="fas fa-trophy"></i> Competiciones ({{ competicionesFiltradas.length }})\r
        </h2>\r
        <div class="flex flex-wrap gap-3 items-center">\r
          <div class="search-box">\r
            <i class="fas fa-search text-gray-500 text-xs"></i>\r
            <input type="text" [(ngModel)]="busquedaNombre" (input)="aplicarFiltro()"\r
                   placeholder="Buscar por nombre..." class="search-input"/>\r
          </div>\r
          <select [(ngModel)]="filtroEstado" (change)="aplicarFiltro()" class="filter-select">\r
            <option value="">Todos los estados</option>\r
            <option *ngFor="let e of estados" [value]="e">{{ e }}</option>\r
          </select>\r
          <button *ngIf="!mostrarFormComp" (click)="abrirFormComp()" class="btn-primary">\r
            <i class="fas fa-plus text-xs"></i> Nueva\r
          </button>\r
        </div>\r
      </div>\r
\r
      <!-- Loading -->\r
      <div *ngIf="cargando" class="flex flex-col items-center justify-center py-16">\r
        <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-blue-500 mb-4"></div>\r
        <p class="text-gray-500 text-sm">Cargando competiciones...</p>\r
      </div>\r
\r
      <!-- Empty -->\r
      <div *ngIf="!cargando && competicionesFiltradas.length === 0"\r
           class="flex flex-col items-center justify-center py-16 text-center">\r
        <i class="fas fa-inbox text-4xl text-gray-600 mb-3"></i>\r
        <p class="text-gray-400 font-semibold">No hay competiciones</p>\r
        <p class="text-gray-600 text-sm mt-1">Cambia los filtros o crea una nueva</p>\r
      </div>\r
\r
      <!-- Tabla -->\r
      <div *ngIf="!cargando && competicionesFiltradas.length > 0" class="overflow-x-auto">\r
        <table class="w-full">\r
          <thead>\r
          <tr class="border-b border-slate-700/50">\r
            <th class="th-cell text-red-400">Nombre</th>\r
            <th class="th-cell text-blue-400">Temporada</th>\r
            <th class="th-cell text-gray-400">Tipo</th>\r
            <th class="th-cell text-gray-400">Tipo Juego</th>\r
            <th class="th-cell text-amber-400">Estado</th>\r
            <th class="th-cell text-red-400" style="text-align:center">Acciones</th>\r
          </tr>\r
          </thead>\r
          <tbody>\r
          <tr *ngFor="let comp of competicionesFiltradas"\r
              class="border-b border-slate-700/30 hover:bg-slate-800/40 transition-colors">\r
            <td class="td-cell font-semibold text-white">{{ comp.nombre }}</td>\r
            <td class="td-cell text-gray-400">{{ comp.temporada }}</td>\r
            <td class="td-cell">\r
              <span class="chip">{{ comp.tipo || 'Liga' }}</span>\r
            </td>\r
            <td class="td-cell">\r
              <span class="chip">{{ comp.tipoJuego || 'Futbol-11' }}</span>\r
            </td>\r
            <td class="td-cell">\r
              <span class="badge" [ngClass]="getBadgeClase(comp.estado)">\r
                <span class="dot" [ngClass]="'dot-' + comp.estado.toLowerCase()"></span>\r
                {{ comp.estado }}\r
              </span>\r
            </td>\r
            <td class="td-cell" style="text-align:center">\r
              <div class="flex gap-2 justify-center">\r
                <a [routerLink]="['/admin/competiciones', comp.id]"\r
                   class="action-btn text-green-300 border-green-500/40 hover:bg-green-500/20"\r
                   title="Gestionar">\r
                  <i class="fas fa-arrow-right text-xs"></i>\r
                </a>\r
                <button (click)="abrirFormComp(comp)" class="action-btn text-blue-300 border-blue-500/40 hover:bg-blue-500/20" title="Editar">\r
                  <i class="fas fa-pen text-xs"></i>\r
                </button>\r
                <button (click)="eliminarComp(comp.id, comp.nombre)" class="action-btn text-red-300 border-red-500/40 hover:bg-red-500/20" title="Eliminar">\r
                  <i class="fas fa-trash text-xs"></i>\r
                </button>\r
              </div>\r
            </td>\r
          </tr>\r
          </tbody>\r
        </table>\r
      </div>\r
    </div>\r
\r
  </div>\r
\r
  <!-- Notificaci\xF3n -->\r
  <div\r
    *ngIf="notificacion.mostrar"\r
    class="fixed bottom-6 right-6 z-50 flex items-center gap-3 px-5 py-3 rounded-xl text-sm font-semibold shadow-2xl transition-all"\r
    [ngClass]="notificacion.tipo === 'exito'\r
      ? 'bg-green-500/90 text-white border border-green-400/50'\r
      : 'bg-red-500/90 text-white border border-red-400/50'">\r
    <i class="fas" [ngClass]="notificacion.tipo === 'exito' ? 'fa-circle-check' : 'fa-circle-xmark'"></i>\r
    {{ notificacion.mensaje }}\r
  </div>\r
\r
  <!-- Modal confirmaci\xF3n -->\r
  <div *ngIf="modalConfirm.mostrar"\r
       class="fixed inset-0 z-50 flex items-center justify-center p-4"\r
       (click)="cerrarConfirm()">\r
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>\r
    <div class="relative z-10 w-full max-w-md section-card rounded-2xl border border-red-500/30 p-6 shadow-2xl"\r
         (click)="$event.stopPropagation()">\r
      <div class="flex items-center justify-center w-14 h-14 rounded-full bg-red-500/15 border border-red-500/30 mx-auto mb-5">\r
        <i class="fas fa-triangle-exclamation text-red-400 text-xl"></i>\r
      </div>\r
      <h3 class="text-lg font-bold text-white text-center mb-2">{{ modalConfirm.titulo }}</h3>\r
      <p class="text-gray-400 text-sm text-center leading-relaxed mb-6">{{ modalConfirm.mensaje }}</p>\r
      <div class="flex gap-3">\r
        <button (click)="cerrarConfirm()" class="flex-1 btn-secondary justify-center">\r
          Cancelar\r
        </button>\r
        <button (click)="confirmar()" class="flex-1 btn-primary justify-center">\r
          <i class="fas fa-trash text-xs"></i> Eliminar\r
        </button>\r
      </div>\r
    </div>\r
  </div>\r
\r
</div>\r
`, styles: ["/* src/app/components/components/admin/admin-competiciones/admin-competiciones.css */\n.tab-btn {\n  color: #6b7280;\n  transition: all 0.15s ease;\n}\n.tab-btn:hover {\n  color: #fff;\n}\n.tab-btn.tab-active {\n  background-color: rgba(59, 130, 246, 0.15);\n  color: #fff;\n  font-weight: 700;\n}\n.stat-card {\n  background: rgba(15, 23, 42, 0.7);\n  border: 0.5px solid rgba(59, 130, 246, 0.15);\n  -webkit-backdrop-filter: blur(8px);\n  backdrop-filter: blur(8px);\n}\n.section-card {\n  background: rgba(15, 23, 42, 0.75);\n  -webkit-backdrop-filter: blur(12px);\n  backdrop-filter: blur(12px);\n}\n.detail-stat-card {\n  background: rgba(30, 41, 59, 0.6);\n  border: 0.5px solid rgba(59, 130, 246, 0.2);\n}\n.liga-detail-card {\n  background: rgba(30, 41, 59, 0.5);\n  transition: background 0.15s ease;\n}\n.liga-detail-card:hover {\n  background: rgba(30, 41, 59, 0.8);\n}\n.field-label {\n  display: block;\n  color: #e2e8f0;\n  font-size: 0.8125rem;\n  font-weight: 600;\n  margin-bottom: 0.375rem;\n}\n.field-input {\n  width: 100%;\n  padding: 0.5rem 0.875rem;\n  background: rgba(2, 6, 23, 0.6);\n  border: 0.5px solid rgba(59, 130, 246, 0.3);\n  border-radius: 0.5rem;\n  color: #fff;\n  font-size: 0.875rem;\n  outline: none;\n  transition: border-color 0.15s ease;\n  font-family: inherit;\n}\n.field-input:focus {\n  border-color: rgba(59, 130, 246, 0.7);\n}\n.field-input option {\n  background: #0f172a;\n  color: #fff;\n}\n.search-box {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  background: rgba(2, 6, 23, 0.6);\n  border: 0.5px solid rgba(59, 130, 246, 0.25);\n  border-radius: 0.5rem;\n  padding: 0.4rem 0.75rem;\n}\n.search-input {\n  background: transparent;\n  border: none;\n  outline: none;\n  color: #fff;\n  font-size: 0.8125rem;\n  width: 180px;\n}\n.search-input::placeholder {\n  color: #4b5563;\n}\n.th-cell {\n  padding: 0.75rem 1.25rem;\n  text-align: left;\n  font-size: 0.6875rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n}\n.td-cell {\n  padding: 0.875rem 1.25rem;\n  font-size: 0.8125rem;\n}\n.btn-primary {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.375rem;\n  padding: 0.5rem 1rem;\n  background:\n    linear-gradient(\n      135deg,\n      #ef4444,\n      #dc2626);\n  color: #fff;\n  font-size: 0.8125rem;\n  font-weight: 700;\n  border-radius: 0.5rem;\n  border: none;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n.btn-primary:hover {\n  background:\n    linear-gradient(\n      135deg,\n      #dc2626,\n      #b91c1c);\n  transform: scale(1.02);\n}\n.btn-secondary {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.375rem;\n  padding: 0.5rem 1rem;\n  background: rgba(30, 41, 59, 0.8);\n  color: #e2e8f0;\n  font-size: 0.8125rem;\n  font-weight: 600;\n  border-radius: 0.5rem;\n  border: 0.5px solid rgba(100, 116, 139, 0.4);\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n.btn-secondary:hover {\n  border-color: rgba(100, 116, 139, 0.7);\n  background: rgba(30, 41, 59, 1);\n}\n.action-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 2rem;\n  height: 2rem;\n  border-radius: 0.4rem;\n  border: 0.5px solid;\n  cursor: pointer;\n  background: transparent;\n  transition: all 0.15s ease;\n}\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.3rem;\n  padding: 0.2rem 0.65rem;\n  border-radius: 9999px;\n  font-size: 0.6875rem;\n  font-weight: 700;\n}\n.badge-activo {\n  background: rgba(34, 197, 94, 0.15);\n  color: #86efac;\n}\n.badge-inactivo {\n  background: rgba(100, 116, 139, 0.2);\n  color: #94a3b8;\n}\n.badge-pausado {\n  background: rgba(245, 158, 11, 0.15);\n  color: #fcd34d;\n}\n.badge-finalizado {\n  background: rgba(107, 114, 128, 0.15);\n  color: #9ca3af;\n}\n.dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  display: inline-block;\n}\n.dot-activo {\n  background: #22c55e;\n}\n.dot-inactivo {\n  background: #64748b;\n}\n.dot-pausado {\n  background: #f59e0b;\n}\n.dot-finalizado {\n  background: #6b7280;\n}\n.chip {\n  display: inline-flex;\n  align-items: center;\n  background: rgba(30, 41, 59, 0.8);\n  border: 0.5px solid rgba(100, 116, 139, 0.3);\n  border-radius: 9999px;\n  padding: 0.15rem 0.65rem;\n  font-size: 0.6875rem;\n  color: #94a3b8;\n  font-weight: 500;\n}\n.filter-select {\n  padding: 0.35rem 0.6rem;\n  background: rgba(2, 6, 23, 0.6);\n  border: 0.5px solid rgba(59, 130, 246, 0.3);\n  border-radius: 0.5rem;\n  color: #fff;\n  font-size: 0.7rem;\n  outline: none;\n  cursor: pointer;\n  width: 200px;\n}\n.filter-select option {\n  background: #0f172a;\n  color: #fff;\n}\n.filter-select:focus {\n  border-color: rgba(59, 130, 246, 0.7);\n}\n/*# sourceMappingURL=admin-competiciones.css.map */\n"] }]
  }], () => [{ type: AdminService }, { type: i013.ChangeDetectorRef }], null);
