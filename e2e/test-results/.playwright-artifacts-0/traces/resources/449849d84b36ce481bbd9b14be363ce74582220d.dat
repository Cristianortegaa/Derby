\r
  <app-navbar></app-navbar>\r
  <div class="h-20"></div>\r
\r
  <div class="absolute top-0 left-0 w-80 h-80 bg-blue-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
  <div class="absolute bottom-0 right-0 w-80 h-80 bg-red-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
\r
  <div class="relative z-10 px-6 md:px-12 py-6 max-w-4xl mx-auto w-full">\r
    <div class="flex items-center justify-between">\r
      <div>\r
        <h1 class="text-3xl font-black mb-1 text-white">Acta del Partido</h1>\r
        <div class="h-1 w-16 bg-gradient-to-r from-red-400 to-blue-400 mt-3 mb-6 rounded-full"></div>\r
      </div>\r
      <a routerLink="/arbitro/mis-partidos"\r
         class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-blue-500/40 rounded-lg text-white hover:border-blue-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
        <i class="fas fa-arrow-left"></i> Volver\r
      </a>\r
    </div>\r
\r
    <!-- CARGANDO -->\r
    <div *ngIf="cargando" class="text-center py-12 text-gray-400">Cargando partido...</div>\r
\r
    <div *ngIf="!cargando && partido">\r
\r
      <!-- INFO DEL PARTIDO -->\r
      <div class="bg-slate-900/80 border border-blue-500/40 rounded-xl p-6 mb-6 text-center">\r
        <div class="flex items-center justify-center gap-6">\r
          <span class="text-xl font-black text-white">{{ partido.equipoLocal?.nombre }}</span>\r
          <span class="text-gray-500 font-bold text-lg">vs</span>\r
          <span class="text-xl font-black text-white">{{ partido.equipoVisitante?.nombre }}</span>\r
        </div>\r
        <p class="text-gray-500 text-sm mt-2">Jornada {{ partido.jornada }}</p>\r
      </div>\r
\r
      <!-- A\xD1ADIR EVENTO -->\r
      <div class="bg-slate-900/80 border border-blue-500/40 rounded-xl p-6 mb-6">\r
        <h2 class="text-lg font-bold text-white mb-4">A\xF1adir evento</h2>\r
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">\r
\r
          <div class="relative">\r
            <label class="block text-gray-400 text-xs font-semibold mb-1">Jugador</label>\r
\r
            <div *ngIf="dropdownAbierto"\r
                 class="fixed inset-0 z-10"\r
                 (click)="dropdownAbierto = false"></div>\r
\r
            <button type="button"\r
                    (click)="dropdownAbierto = !dropdownAbierto"\r
                    class="relative z-20 w-full px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-sm text-left flex items-center justify-between transition-all"\r
                    [class.text-white]="nuevoEvento.jugadorId !== 0"\r
                    [class.text-gray-500]="nuevoEvento.jugadorId === 0">\r
              {{ jugadorSeleccionadoNombre }}\r
              <i class="fas fa-chevron-down text-gray-400 text-xs ml-2"></i>\r
            </button>\r
\r
            <div *ngIf="dropdownAbierto"\r
                 class="absolute z-30 mt-1 w-full bg-slate-900 border border-blue-500/40 rounded-lg shadow-xl overflow-hidden max-h-64 overflow-y-auto">\r
\r
              <div class="px-3 py-2 bg-blue-600/20 border-b border-blue-500/30">\r
                <span class="text-blue-400 text-xs font-black uppercase tracking-wider">\r
                  <i class="fas fa-shield-halved mr-1"></i>{{ partido.equipoLocal?.nombre }}\r
                </span>\r
              </div>\r
              <div *ngFor="let j of jugadoresLocal"\r
                   (click)="seleccionarJugador(j.id, j.nombre)"\r
                   class="px-4 py-2 text-sm text-gray-300 hover:bg-blue-600/20 hover:text-white cursor-pointer transition-colors">\r
                {{ j.nombre }}\r
              </div>\r
\r
              <div class="px-3 py-2 bg-red-600/20 border-t border-b border-red-500/30">\r
                <span class="text-red-400 text-xs font-black uppercase tracking-wider">\r
                  <i class="fas fa-shield-halved mr-1"></i>{{ partido.equipoVisitante?.nombre }}\r
                </span>\r
              </div>\r
              <div *ngFor="let j of jugadoresVisitante"\r
                   (click)="seleccionarJugador(j.id, j.nombre)"\r
                   class="px-4 py-2 text-sm text-gray-300 hover:bg-red-600/20 hover:text-white cursor-pointer transition-colors">\r
                {{ j.nombre }}\r
              </div>\r
\r
            </div>\r
          </div>\r
\r
          <div>\r
            <label class="block text-gray-400 text-xs font-semibold mb-1">Minuto</label>\r
            <input type="number" [(ngModel)]="nuevoEvento.minuto" min="1" max="120"\r
                   class="w-full px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 focus:outline-none">\r
          </div>\r
\r
          <div>\r
            <label class="block text-gray-400 text-xs font-semibold mb-1">Tipo</label>\r
            <select [(ngModel)]="nuevoEvento.tipoEvento"\r
                    class="w-full px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 focus:outline-none">\r
              <option value="Gol">Gol</option>\r
              <option value="TarjetaAmarilla">Tarjeta Amarilla</option>\r
              <option value="TarjetaRoja">Tarjeta Roja</option>\r
            </select>\r
          </div>\r
\r
        </div>\r
        <button (click)="agregarEvento()" [disabled]="cargandoEvento"\r
                class="px-6 py-2 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-500 hover:to-blue-600 disabled:opacity-50 text-white font-semibold rounded-lg transition-all text-sm">\r
          {{ cargandoEvento ? 'A\xF1adiendo...' : '+ A\xF1adir evento' }}\r
        </button>\r
      </div>\r
\r
      <!-- LISTA DE EVENTOS -->\r
      <div class="bg-slate-900/80 border border-blue-500/40 rounded-xl p-6 mb-6">\r
        <h2 class="text-lg font-bold text-white mb-4">Eventos del partido ({{ eventos.length }})</h2>\r
\r
        <div *ngIf="eventos.length === 0" class="text-center py-6 text-gray-500">\r
          No hay eventos registrados todav\xEDa\r
        </div>\r
\r
        <div class="space-y-2">\r
          <div *ngFor="let evento of eventos"\r
               class="flex items-center justify-between bg-slate-800/50 border border-slate-700/50 rounded-lg px-4 py-3">\r
            <div class="flex items-center gap-3">\r
              <i [class]="getIconoEvento(evento.tipoEvento) + ' text-lg'"></i>\r
              <span class="text-white font-semibold">{{ evento.nombreJugador }}</span>\r
              <span class="text-gray-400 text-sm">min. {{ evento.minuto }}</span>\r
            </div>\r
            <button (click)="eliminarEvento(evento.id)"\r
                    class="text-red-400 hover:text-red-300 text-xs font-bold px-2 py-1 rounded transition-all">\r
              <i class="fas fa-xmark"></i>\r
            </button>\r
          </div>\r
        </div>\r
      </div>\r
\r
      <!-- CERRAR ACTA -->\r
      <div class="flex justify-end">\r
        <button (click)="cerrarActa()"\r
                class="px-8 py-3 bg-gradient-to-r from-green-600 to-green-700 hover:from-green-500 hover:to-green-600 text-white font-bold rounded-lg transition-all">\r
          <i class="fas fa-check mr-1"></i> Cerrar Acta\r
        </button>\r
      </div>\r
\r
    </div>\r
  </div>\r
\r
  <!-- Modal confirmaci\xF3n -->\r
  <div *ngIf="modalConfirm.mostrar"\r
       class="fixed inset-0 z-50 flex items-center justify-center p-4"\r
       (click)="cerrarConfirm()">\r
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>\r
    <div class="relative z-10 w-full max-w-md bg-slate-900 rounded-2xl border border-green-500/30 p-6 shadow-2xl"\r
         (click)="$event.stopPropagation()">\r
      <div class="flex items-center justify-center w-14 h-14 rounded-full bg-green-500/15 border border-green-500/30 mx-auto mb-5">\r
        <i class="fas fa-check text-green-400 text-xl"></i>\r
      </div>\r
      <h3 class="text-lg font-bold text-white text-center mb-2">{{ modalConfirm.titulo }}</h3>\r
      <p class="text-gray-400 text-sm text-center leading-relaxed mb-6">{{ modalConfirm.mensaje }}</p>\r
      <div class="flex gap-3">\r
        <button (click)="cerrarConfirm()" class="flex-1 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-lg border border-slate-600 transition-all">\r
          Cancelar\r
        </button>\r
        <a routerLink="/arbitro/mis-partidos" (click)="confirmar()" class="flex-1 px-4 py-2 bg-gradient-to-r from-green-600 to-green-700 hover:from-green-500 hover:to-green-600 text-white font-semibold rounded-lg transition-all">\r
          <i class="fas fa-check text-xs mr-1"></i> {{ modalConfirm.textoConfirmar }}\r
        </a>\r
      </div>\r
    </div>\r
  </div>\r
\r
</div>\r
