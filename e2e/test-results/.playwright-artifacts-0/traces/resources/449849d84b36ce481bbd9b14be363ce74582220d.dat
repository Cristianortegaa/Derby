(() => {
  (typeof ngDevMode === "undefined" || ngDevMode) && i012.\u0275setClassMetadata(AdminUsuarios, [{
    type: Component8,
    args: [{ selector: "app-admin-usuarios", standalone: true, imports: [CommonModule8, FormsModule3, RouterLink5, NavbarComponent], template: `<div\r
  class="w-full min-h-screen flex flex-col bg-gradient-to-br from-slate-950 via-slate-950 to-slate-900 text-white relative">\r
  <div class="absolute top-0 left-0 w-80 h-80 bg-blue-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
  <div\r
    class="absolute bottom-0 right-0 w-80 h-80 bg-red-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
  <div\r
    class="absolute top-1/2 left-1/2 w-96 h-96 bg-blue-600 opacity-5 blur-3xl rounded-full pointer-events-none -translate-x-1/2 -translate-y-1/2"></div>\r
\r
  <div class="relative z-10 px-6 md:px-12 py-8 max-w-7xl mx-auto w-full">\r
    <div class="flex items-center justify-between mb-8">\r
      <div>\r
        <h1 class="text-3xl md:text-4xl font-black mb-2 text-white">\r
          Gesti\xF3n de Usuarios\r
        </h1>\r
        <p class="text-gray-500 text-sm md:text-base font-medium">Administra todos los usuarios del sistema</p>\r
        <div class="h-1 w-16 bg-gradient-to-r from-red-400 to-blue-400 mt-3 rounded-full"></div>\r
      </div>\r
      <button routerLink="/admin"\r
              class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-blue-500/40 rounded-lg text-white hover:border-blue-400/80 hover:bg-slate-800 transition-all">\r
        <i class="fas fa-arrow-left"></i> Volver\r
      </button>\r
    </div>\r
  </div>\r
\r
  <main class="relative z-10 flex-1 px-6 md:px-12 pb-20 max-w-7xl mx-auto w-full">\r
\r
    <!-- BOT\xD3N AGREGAR USUARIO -->\r
    <div class="mb-6 flex justify-between items-center">\r
      <button\r
        *ngIf="!mostrarForm"\r
        (click)="abrirFormulario()"\r
        class="flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white font-bold rounded-lg transition-all shadow-lg hover:shadow-red-500/50 transform hover:scale-105">\r
        <i class="fas fa-plus text-s"></i> Agregar Usuario\r
      </button>\r
    </div>\r
\r
    <!-- FORMULARIO DE CREAR/EDITAR USUARIO -->\r
    <div *ngIf="mostrarForm"\r
         class="bg-slate-900/80 backdrop-blur-md border border-blue-500/40 rounded-xl p-8 shadow-lg mb-6">\r
      <h2 class="text-2xl font-bold text-white mb-6">\r
        <i class="fas" [ngClass]="editandoId ? 'fa-edit' : 'fa-user-plus'"></i>\r
        {{ editandoId ? ' Editar Usuario' : ' Nuevo Usuario' }}\r
      </h2>\r
\r
      <form class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">\r
        <!-- Email -->\r
        <div>\r
          <label class="block text-white text-sm font-semibold mb-2">\r
            <span class="text-red-400">*</span> Email\r
          </label>\r
          <input\r
            type="email"\r
            [(ngModel)]="formulario.email"\r
            name="email"\r
            placeholder="usuario@derby.com"\r
            class="w-full px-4 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm placeholder-gray-500 focus:border-blue-400 focus:outline-none transition-all"\r
          />\r
        </div>\r
\r
        <!-- Contrase\xF1a -->\r
        <div>\r
          <label class="block text-white text-sm font-semibold mb-2">\r
            <span class="text-red-400">{{ editandoId ? '' : '*' }}</span> Contrase\xF1a\r
          </label>\r
          <input\r
            type="password"\r
            [(ngModel)]="formulario.contrasena"\r
            name="contrasena"\r
            [placeholder]="editandoId ? 'Dejar en blanco para no cambiar' : 'Ingresa contrase\xF1a segura'"\r
            class="w-full px-4 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm placeholder-gray-500 focus:border-blue-400 focus:outline-none transition-all"\r
          />\r
          <p class="text-gray-400 text-xs mt-1">{{ editandoId ? 'Opcional' : 'M\xEDnimo 8 caracteres' }}</p>\r
        </div>\r
\r
        <!-- Rol -->\r
        <div>\r
          <label class="block text-white text-sm font-semibold mb-2">\r
            <span class="text-red-400">*</span> Rol\r
          </label>\r
          <select\r
            [(ngModel)]="formulario.rol"\r
            name="rol"\r
            class="w-full px-4 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 focus:outline-none transition-all"\r
          >\r
            <option value="">Seleccionar rol</option>\r
            <option *ngFor="let rol of roles" [value]="rol">{{ rol }}</option>\r
          </select>\r
        </div>\r
        <!-- Nombre (solo \xC1rbitro) -->\r
        <div *ngIf="formulario.rol === 'Arbitro'">\r
          <label class="block text-white text-sm font-semibold mb-2">\r
            <span class="text-red-400">*</span> Nombre\r
          </label>\r
          <input\r
            type="text"\r
            [(ngModel)]="formulario.nombre"\r
            name="nombre"\r
            placeholder="Nombre del \xE1rbitro"\r
            class="w-full px-4 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm placeholder-gray-500 focus:border-blue-400 focus:outline-none transition-all"\r
          />\r
        </div>\r
\r
        <!-- Apellidos (solo \xC1rbitro) -->\r
        <div *ngIf="formulario.rol === 'Arbitro'">\r
          <label class="block text-white text-sm font-semibold mb-2">\r
            <span class="text-red-400">*</span> Apellidos\r
          </label>\r
          <input\r
            type="text"\r
            [(ngModel)]="formulario.apellidos"\r
            name="apellidos"\r
            placeholder="Apellidos del \xE1rbitro"\r
            class="w-full px-4 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm placeholder-gray-500 focus:border-blue-400 focus:outline-none transition-all"\r
          />\r
        </div>\r
      </form>\r
\r
      <!-- Botones de acci\xF3n -->\r
      <div class="mt-8 flex gap-4 justify-end">\r
        <button\r
          type="button"\r
          (click)="cerrarFormulario()"\r
          class="px-6 py-2 bg-slate-800 border border-slate-600 text-white font-semibold rounded-lg hover:border-slate-500 transition-all"\r
        >\r
          Cancelar\r
        </button>\r
        <button\r
          type="button"\r
          (click)="guardarUsuario()"\r
          class="px-6 py-2 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white font-semibold rounded-lg transition-all shadow-lg hover:shadow-blue-500/50"\r
        >\r
          <i class="fas" [ngClass]="editandoId ? 'fa-save' : 'fa-check'"></i>\r
          {{ editandoId ? ' Actualizar' : ' Crear' }}\r
        </button>\r
      </div>\r
    </div>\r
\r
    <!-- TABLA DE USUARIOS -->\r
    <div class="bg-slate-900/80 backdrop-blur-md border border-blue-500/40 rounded-xl p-6 shadow-lg">\r
      <div class="mb-6">\r
        <h2 class="text-lg font-bold text-red-400 mb-4">\r
          <i class="fas fa-users mr-2"></i>Lista de Usuarios ({{ usuariosFiltrados.length }})\r
        </h2>\r
\r
         <!-- FILTRO DE ROLES Y BUSCADOR -->\r
         <div class="flex flex-wrap gap-3 mb-4 items-center justify-between">\r
           <!-- Botones de filtro -->\r
           <div class="flex flex-wrap gap-3">\r
             <button\r
               (click)="cambiarFiltro('Todos')"\r
               class="filter-todos px-4 py-2 rounded-lg font-semibold text-sm transition-all hover:scale-105"\r
               [ngClass]="{\r
                 'bg-gradient-to-r from-blue-500 to-blue-600 text-white shadow-lg shadow-blue-500/50': filtroRol === 'Todos',\r
                 'bg-slate-800 text-gray-400 border border-slate-600': filtroRol !== 'Todos'\r
               }">\r
               <i class="fas fa-list mr-2"></i>Todos\r
             </button>\r
             <button\r
               (click)="cambiarFiltro('Administrador')"\r
               class="filter-admin px-4 py-2 rounded-lg font-semibold text-sm transition-all hover:scale-105"\r
               [ngClass]="{\r
                 'bg-gradient-to-r from-red-500 to-red-600 text-white shadow-lg shadow-red-500/50': filtroRol === 'Administrador',\r
                 'bg-slate-800 text-gray-400 border border-slate-600': filtroRol !== 'Administrador'\r
               }">\r
               <i class="fa-solid fa-gear mr-2"></i> Admin\r
             </button>\r
             <button\r
               (click)="cambiarFiltro('Arbitro')"\r
               class="filter-arbitro px-4 py-2 rounded-lg font-semibold text-sm transition-all hover:scale-105"\r
               [ngClass]="{\r
                 'bg-gradient-to-r from-blue-500 to-blue-600 text-white shadow-lg shadow-blue-500/50': filtroRol === 'Arbitro',\r
                 'bg-slate-800 text-gray-400 border border-slate-600': filtroRol !== 'Arbitro'\r
               }">\r
               <i class="fa-solid fa-stopwatch mr-2"></i> Arbitro\r
             </button>\r
             <button\r
               (click)="cambiarFiltro('Aficionado')"\r
               class="filter-aficionado px-4 py-2 rounded-lg font-semibold text-sm transition-all hover:scale-105"\r
               [ngClass]="{\r
                 'bg-gradient-to-r from-green-500 to-green-600 text-white shadow-lg shadow-green-500/50': filtroRol === 'Aficionado',\r
                 'bg-slate-800 text-gray-400 border border-slate-600': filtroRol !== 'Aficionado'\r
               }">\r
               <i class="fas fa-user mr-2"></i>Aficionado\r
             </button>\r
           </div>\r
\r
           <!-- BUSCADOR DE EMAIL -->\r
           <div class="relative mb-1 flex items-center justify-center">\r
             <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 text-sm"></i>\r
             <input\r
               type="text"\r
               [(ngModel)]="busquedaEmail"\r
               (input)="aplicarFiltro()"\r
               placeholder="Buscar por email..."\r
               class="pl-10 pr-4 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm placeholder-gray-500 focus:border-blue-400 focus:outline-none transition-all w-64"\r
             />\r
           </div>\r
         </div>\r
       </div>\r
\r
      <!-- Estado de carga -->\r
      <div *ngIf="cargando" class="flex flex-col items-center justify-center py-12">\r
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-500"></div>\r
        <p class="text-gray-400 mt-4">Cargando usuarios...</p>\r
      </div>\r
\r
       <!-- Sin datos -->\r
       <div *ngIf="!cargando && usuariosFiltrados.length === 0" class="text-center py-12">\r
         <i class="fas fa-inbox text-4xl text-gray-500 mb-4"></i>\r
         <p class="text-gray-400 text-lg">No hay usuarios con este filtro</p>\r
         <p class="text-gray-500 text-sm mt-2">Intenta seleccionar otro filtro o crea nuevos usuarios</p>\r
       </div>\r
\r
       <!-- Tabla -->\r
       <div *ngIf="!cargando && usuariosFiltrados.length > 0" class="overflow-x-auto">\r
        <table class="w-full">\r
          <thead>\r
          <tr class="border-b border-blue-500/30">\r
            <th class="px-6 py-4 text-left text-red-400 font-semibold text-sm">ID</th>\r
            <th class="px-6 py-4 text-left text-red-400 font-semibold text-sm">Email</th>\r
            <th class="px-6 py-4 text-left text-red-400 font-semibold text-sm">Rol</th>\r
            <th class="px-6 py-4 text-center text-red-400 font-semibold text-sm">Acciones</th>\r
          </tr>\r
          </thead>\r
           <tbody>\r
           <tr *ngFor="let usuario of usuariosFiltrados"\r
               class="border-b border-slate-700/50 hover:bg-slate-800/50 transition-colors">\r
            <td class="px-6 py-4 text-white text-sm font-medium">{{ usuario.id }}</td>\r
            <td class="px-6 py-4 text-white text-sm">{{ usuario.email }}</td>\r
            <td class="px-6 py-4 text-sm">\r
                <span\r
                  class="px-3 py-1 rounded-full text-xs font-bold"\r
                  [ngClass]="{\r
                    'bg-red-500/30 text-red-200': usuario.rol === 'Administrador',\r
                    'bg-blue-500/30 text-blue-200': usuario.rol === 'Arbitro',\r
                    'bg-green-500/30 text-green-200': usuario.rol === 'Aficionado'\r
                  }"\r
                >\r
                  {{ usuario.rol }}\r
                </span>\r
            </td>\r
            <td class="px-6 py-4 text-center">\r
              <div class="flex gap-3 justify-center">\r
                <button\r
                  (click)="abrirFormulario(usuario)"\r
                  class="inline-flex items-center gap-2 px-3 py-1 bg-blue-500/20 border border-blue-500/50 text-blue-300 rounded-lg hover:bg-blue-500/40 transition-all text-xs font-semibold"\r
                >\r
                  <i class="fas fa-edit"></i> Editar\r
                </button>\r
                <button\r
                  (click)="eliminarUsuario(usuario.id, usuario.email)"\r
                  class="inline-flex items-center gap-2 px-3 py-1 bg-red-500/20 border border-red-500/50 text-red-300 rounded-lg hover:bg-red-500/40 transition-all text-xs font-semibold"\r
                >\r
                  <i class="fas fa-trash"></i> Eliminar\r
                </button>\r
              </div>\r
            </td>\r
          </tr>\r
          </tbody>\r
        </table>\r
      </div>\r
    </div>\r
\r
  </main>\r
  <div\r
    *ngIf="notificacion.mostrar"\r
    class="fixed bottom-6 right-6 z-50 px-4 py-2 rounded text-sm text-white"\r
    [ngClass]="notificacion.tipo === 'exito' ? 'bg-green-600' : 'bg-red-600'"\r
  >\r
    {{ notificacion.mensaje }}\r
  </div>\r
\r
  <!-- Modal confirmaci\xF3n -->\r
  <div *ngIf="modalConfirm.mostrar"\r
       class="fixed inset-0 z-50 flex items-center justify-center p-4"\r
       (click)="cerrarConfirm()">\r
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>\r
    <div class="relative z-10 w-full max-w-md bg-slate-900 rounded-2xl border border-red-500/30 p-6 shadow-2xl"\r
         (click)="$event.stopPropagation()">\r
      <div class="flex items-center justify-center w-14 h-14 rounded-full bg-red-500/15 border border-red-500/30 mx-auto mb-5">\r
        <i class="fas fa-triangle-exclamation text-red-400 text-xl"></i>\r
      </div>\r
      <h3 class="text-lg font-bold text-white text-center mb-2">{{ modalConfirm.titulo }}</h3>\r
      <p class="text-gray-400 text-sm text-center leading-relaxed mb-6">{{ modalConfirm.mensaje }}</p>\r
      <div class="flex gap-3">\r
        <button (click)="cerrarConfirm()" class="flex-1 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-lg border border-slate-600 transition-all">\r
          Cancelar\r
        </button>\r
        <button (click)="confirmar()" class="flex-1 px-4 py-2 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-semibold rounded-lg transition-all">\r
          <i class="fas fa-trash text-xs mr-1"></i> {{ modalConfirm.textoConfirmar }}\r
        </button>\r
      </div>\r
    </div>\r
  </div>\r
\r
</div>\r
\r
`, styles: ["/* src/app/components/components/admin/admin-usuarios/admin-usuarios.css */\n@keyframes spin {\n  from {\n    transform: rotate(0deg);\n  }\n  to {\n    transform: rotate(360deg);\n  }\n}\n.animate-spin {\n  animation: spin 1s linear infinite;\n}\nbutton:hover {\n  transition: all 0.3s ease;\n}\n@media (max-width: 768px) {\n  table {\n    font-size: 0.875rem;\n  }\n  th,\n  td {\n    padding: 0.75rem 0.5rem !important;\n  }\n  .flex.gap-3 {\n    flex-direction: column;\n  }\n  button {\n    width: 100%;\n  }\n}\ninput:focus,\nselect:focus,\nbutton:focus {\n  outline: 2px solid #3b82f6;\n  outline-offset: 2px;\n}\n.filter-todos:focus {\n  outline: 2px solid #3b82f6 !important;\n  outline-offset: 2px;\n}\n.filter-admin:focus {\n  outline: 2px solid #ef4444 !important;\n  outline-offset: 2px;\n}\n.filter-arbitro:focus {\n  outline: 2px solid #3b82f6 !important;\n  outline-offset: 2px;\n}\n.filter-aficionado:focus {\n  outline: 2px solid #22c55e !important;\n  outline-offset: 2px;\n}\n* {\n  transition:\n    background-color 0.3s ease,\n    color 0.3s ease,\n    border-color 0.3s ease;\n}\n/*# sourceMappingURL=admin-usuarios.css.map */\n"] }]
