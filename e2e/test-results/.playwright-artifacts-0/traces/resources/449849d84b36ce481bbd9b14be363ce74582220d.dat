\r
  <app-navbar></app-navbar>\r
  <div class="h-20"></div>\r
\r
  <div class="absolute top-0 left-0 w-96 h-96 bg-blue-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-red-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
\r
  <div class="relative z-10 px-6 md:px-12 py-8 max-w-7xl mx-auto w-full">\r
\r
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">\r
      <div>\r
        <h1 class="text-3xl md:text-4xl font-black mb-1 text-white">Calendario</h1>\r
        <p class="text-gray-500 text-sm font-medium">Calendario de partidos por jornada</p>\r
        <div class="h-1 w-16 bg-gradient-to-r from-red-400 to-blue-400 mt-3 rounded-full"></div>\r
      </div>\r
\r
      <div class="flex items-center gap-3">\r
        <a *ngIf="ligaIdFijado"\r
           [routerLink]="['/admin/ligas', ligaIdFijado]"\r
           class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-green-500/40 rounded-lg text-white hover:border-green-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
          <i class="fas fa-arrow-left"></i> Volver a Liga\r
        </a>\r
        <a *ngIf="competicionIdFijado && !ligaIdFijado"\r
           [routerLink]="['/admin/competiciones', competicionIdFijado]"\r
           class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-green-500/40 rounded-lg text-white hover:border-green-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
          <i class="fas fa-arrow-left"></i> Volver a Competici\xF3n\r
        </a>\r
        <a *ngIf="!competicionIdFijado && !ligaIdFijado" routerLink="/admin"\r
           class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-blue-500/40 rounded-lg text-white hover:border-blue-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
          <i class="fas fa-arrow-left"></i> Volver\r
        </a>\r
      </div>\r
    </div>\r
\r
    <div class="bg-slate-900/80 border border-blue-500/20 rounded-xl p-6 mb-6">\r
      <label class="block text-white text-sm font-semibold mb-3">Selecciona una jornada:</label>\r
      <div class="flex flex-wrap gap-4">\r
        <select [(ngModel)]="jornadaSeleccionada" name="jornada"\r
                class="px-4 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white focus:border-blue-400 outline-none">\r
          <option [ngValue]="0">Todas las jornadas</option>\r
          <option *ngFor="let j of jornadas" [ngValue]="j.numero">Jornada {{ j.numero }}</option>\r
        </select>\r
      </div>\r
    </div>\r
\r
    <div *ngIf="cargando" class="text-center py-8">\r
      <p class="text-gray-400">Cargando calendario...</p>\r
    </div>\r
\r
    <div *ngIf="!cargando && jornadas.length === 0" class="text-center py-8">\r
      <i class="fas fa-inbox text-4xl text-gray-600 mb-3"></i>\r
      <p class="text-gray-400">No hay partidos programados</p>\r
    </div>\r
\r
    <div *ngIf="!cargando && jornadas.length > 0" class="space-y-6">\r
      <div *ngFor="let jornada of jornadasFiltradas" class="bg-slate-900/80 border border-blue-500/20 rounded-xl p-6">\r
        <h3 class="text-xl font-bold text-yellow-400 mb-4"><i class="fas fa-calendar-days mr-2"></i>Jornada {{ jornada.numero }}</h3>\r
\r
        <div class="space-y-3">\r
          <div *ngFor="let partido of jornada.partidos"\r
               class="bg-slate-950/50 border border-slate-700/50 rounded-lg p-4 hover:border-blue-500/50 transition">\r
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">\r
\r
              <div class="text-center">\r
                <p class="text-white font-bold">{{ partido.equipoLocal?.nombre || 'Equipo Local' }}</p>\r
                <p class="text-gray-400 text-sm">Local</p>\r
              </div>\r
\r
              <div class="text-center">\r
                <div class="flex items-center justify-center gap-3">\r
                  <div class="text-2xl font-bold text-green-400">{{ partido.golesLocal ?? '-' }}</div>\r
                  <div class="text-gray-400">-</div>\r
                  <div class="text-2xl font-bold text-green-400">{{ partido.golesVisitante ?? '-' }}</div>\r
                </div>\r
                <p class="text-gray-400 text-xs mt-1">{{ partido.fechaHora ? (partido.fechaHora | date: 'dd/MM HH:mm') : 'Sin fecha' }}</p>\r
                <p class="text-xs px-2 py-1 rounded mt-1 inline-block"\r
                   [ngClass]="{\r
                     'bg-yellow-500/20 text-yellow-400': partido.estado === 'Pendiente',\r
                     'bg-red-500/20 text-red-400': partido.estado === 'En juego',\r
                     'bg-green-500/20 text-green-400': partido.estado === 'Finalizado'\r
                   }">\r
                  {{ partido.estado }}\r
                </p>\r
              </div>\r
\r
              <div class="text-center">\r
                <p class="text-white font-bold">{{ partido.equipoVisitante?.nombre || 'Equipo Visitante' }}</p>\r
                <p class="text-gray-400 text-sm">Visitante</p>\r
              </div>\r
\r
            </div>\r
          </div>\r
        </div>\r
      </div>\r
    </div>\r
\r
  </div>\r
\r
</div>\r
`, styles: ["/* src/app/components/components/admin/admin-calendario/admin-calendario.css */\n/*# sourceMappingURL=admin-calendario.css.map */\n"] }]
