    args: [{ selector: "app-competiciones", standalone: true, imports: [CommonModule6, NavbarComponent, FormsModule2], template: `<div class="w-full min-h-screen flex flex-col bg-gradient-to-br from-slate-950 via-slate-950 to-slate-900 text-white relative">\r
\r
  <app-navbar></app-navbar>\r
\r
  <div class="h-20"></div>\r
\r
  <div class="absolute top-0 left-0 w-80 h-80 bg-blue-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
  <div class="absolute bottom-0 right-0 w-80 h-80 bg-red-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
  <div class="absolute top-1/2 left-1/2 w-96 h-96 bg-blue-600 opacity-5 blur-3xl rounded-full pointer-events-none -translate-x-1/2 -translate-y-1/2"></div>\r
\r
  <div class="relative z-10 px-6 md:px-12 py-6 max-w-7xl mx-auto w-full">\r
    <h1 class="text-3xl md:text-4xl font-black mb-2 text-white mt-2">\r
      Competiciones\r
    </h1>\r
    <p class="text-gray-500 text-sm md:text-base font-medium">Informaci\xF3n completa de todas las competiciones</p>\r
    <div class="h-1 w-16 bg-gradient-to-r from-red-400 to-blue-400 mt-3 rounded-full"></div>\r
  </div>\r
\r
  <main class="relative z-10 flex-1 px-6 md:px-12 pb-20 max-w-7xl mx-auto w-full">\r
\r
    <!-- FILTROS DE B\xDASQUEDA -->\r
    <div class="bg-slate-900/80 backdrop-blur-md border border-blue-500/40 rounded-xl p-5 shadow-lg mb-6">\r
      <h2 class="text-lg font-bold text-red-400 mb-4">\r
        <i class="fas fa-filter mr-2"></i>Filtro de B\xFAsquedas\r
      </h2>\r
\r
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">\r
        <div>\r
          <label class="block text-white text-sm font-semibold mb-2">\r
            <span class="text-red-400">*</span> COMPETICI\xD3N\r
          </label>\r
          <select [(ngModel)]="competicionSeleccionada" (change)="cambiarCompeticion()"\r
                  class="w-full px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 focus:outline-none transition-all">\r
            <option [value]="0">Seleccionar competici\xF3n</option>\r
            <option *ngFor="let comp of competiciones" [value]="comp.id">{{ comp.nombre }}</option>\r
          </select>\r
        </div>\r
\r
        <div>\r
          <label class="block text-white text-sm font-semibold mb-2">\r
            <span class="text-red-400">*</span> LIGA\r
          </label>\r
          <select [(ngModel)]="ligaSeleccionada" (change)="cambiarLiga()"\r
                  [disabled]="!competicionSeleccionada"\r
                  class="w-full px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 focus:outline-none transition-all disabled:opacity-50">\r
            <option [value]="0">Seleccionar liga</option>\r
            <option *ngFor="let liga of ligas" [value]="liga.id">{{ liga.nombre }}</option>\r
          </select>\r
        </div>\r
      </div>\r
\r
      <!-- Mensaje de error -->\r
      <div *ngIf="error" class="mt-4 p-4 bg-red-500/20 border border-red-500/60 rounded-lg">\r
        <p class="text-red-400 font-semibold">\r
          <i class="fas fa-exclamation-circle mr-2"></i>{{ error }}\r
        </p>\r
      </div>\r
    </div>\r
\r
    <!-- CALENDARIO DE PARTIDOS -->\r
    <div class="bg-slate-900/80 backdrop-blur-md border border-blue-500/40 rounded-xl p-5 shadow-lg">\r
      <!-- Tabs/Men\xFA -->\r
      <div class="flex gap-2 mb-6 border-b border-blue-500/30 pb-4 overflow-x-auto">\r
        <button\r
          (click)="cambiarTab('calendario')"\r
          [class.border-b-2]="tabActiva === 'calendario'"\r
          [class.border-red-400]="tabActiva === 'calendario'"\r
          [class.text-red-400]="tabActiva === 'calendario'"\r
          [class.text-slate-400]="tabActiva !== 'calendario'"\r
          class="px-4 py-2 font-semibold text-sm whitespace-nowrap transition-all hover:text-white">\r
          <i class="fas fa-calendar mr-2"></i>Calendario\r
        </button>\r
\r
        <button\r
          (click)="cambiarTab('clasificacion')"\r
          [class.border-b-2]="tabActiva === 'clasificacion'"\r
          [class.border-blue-400]="tabActiva === 'clasificacion'"\r
          [class.text-blue-400]="tabActiva === 'clasificacion'"\r
          [class.text-slate-400]="tabActiva !== 'clasificacion'"\r
          class="px-4 py-2 font-semibold text-sm whitespace-nowrap transition-all hover:text-white">\r
          <i class="fas fa-ranking-star mr-2"></i>Clasificaci\xF3n\r
        </button>\r
\r
        <button\r
          (click)="cambiarTab('resultados')"\r
          [class.border-b-2]="tabActiva === 'resultados'"\r
          [class.border-amber-400]="tabActiva === 'resultados'"\r
          [class.text-amber-400]="tabActiva === 'resultados'"\r
          [class.text-slate-400]="tabActiva !== 'resultados'"\r
          class="px-4 py-2 font-semibold text-sm whitespace-nowrap transition-all hover:text-white">\r
          <i class="fas fa-list-check mr-2"></i>Resultados y Jornadas\r
        </button>\r
\r
        <button\r
          (click)="cambiarTab('goleadores')"\r
          [class.border-b-2]="tabActiva === 'goleadores'"\r
          [class.border-orange-400]="tabActiva === 'goleadores'"\r
          [class.text-orange-400]="tabActiva === 'goleadores'"\r
          [class.text-slate-400]="tabActiva !== 'goleadores'"\r
          class="px-4 py-2 font-semibold text-sm whitespace-nowrap transition-all hover:text-white">\r
          <i class="fas fa-shoe-prints mr-2"></i>Goleadores\r
        </button>\r
      </div>\r
\r
      <!-- Contenido de Pesta\xF1as -->\r
      <div class="animate-fadeIn">\r
\r
        <!-- TAB: CALENDARIO -->\r
        <div *ngIf="tabActiva === 'calendario'">\r
          <h2 class="text-xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-red-400 to-blue-400 mb-4">\r
            <i class="fas fa-calendar mr-2"></i>Calendario de Partidos\r
          </h2>\r
\r
          <div class="flex items-center gap-3 mb-6">\r
            <label class="text-gray-400 text-sm font-semibold">Jornada:</label>\r
            <select [(ngModel)]="filtroJornada"\r
                    class="px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 focus:outline-none">\r
              <option [ngValue]="null">Todas</option>\r
              <option *ngFor="let j of jornadas" [ngValue]="j.numero">Jornada {{ j.numero }}</option>\r
            </select>\r
          </div>\r
\r
          <!-- Jornadas y Partidos -->\r
          <div class="space-y-6">\r
            <div *ngFor="let jornada of jornadasFiltradas; let i = index" class="border-l-4 border-blue-500/60 pl-4">\r
              <h3 class="text-lg font-bold text-blue-300 mb-4">\r
                <i class="fas fa-layer-group mr-2"></i>Jornada {{ jornada.numero }}\r
              </h3>\r
\r
              <div class="space-y-3">\r
                <div *ngFor="let partido of jornada.partidos"\r
                  class="bg-slate-950/70 border border-slate-700/60 rounded-lg p-4 hover:border-blue-500/60 hover:shadow-md transition-all flex items-center justify-between">\r
\r
                  <!-- Equipo Local -->\r
                  <div class="flex items-center gap-3 flex-1">\r
                    <div class="w-10 h-10 bg-slate-800 rounded-full flex items-center justify-center">\r
                      <img *ngIf="partido.equipoLocal.escudoUrl" [src]="partido.equipoLocal.escudoUrl" alt="" class="w-10 h-10 rounded-full object-contain">\r
                      <i *ngIf="!partido.equipoLocal.escudoUrl" class="fas fa-futbol text-red-400"></i>\r
                    </div>\r
                    <div>\r
                      <p class="text-white text-sm font-semibold">{{ partido.equipoLocal.nombre }}</p>\r
                      <p class="text-slate-400 text-xs">Local</p>\r
                    </div>\r
                  </div>\r
\r
                  <!-- Resultado -->\r
                  <div class="text-center px-4">\r
                    <div class="text-2xl font-bold text-yellow-400">\r
                      {{ partido.golesLocal }} - {{ partido.golesVisitante }}\r
                    </div>\r
                    <p class="text-slate-400 text-xs mt-1">\r
                      <span *ngIf="partido.estado === 'jugado'" class="text-green-400">FINAL</span>\r
                      <span *ngIf="partido.estado === 'en-juego'" class="text-red-400 animate-pulse">EN JUEGO</span>\r
                      <span *ngIf="partido.estado === 'pendiente'" class="text-blue-400">PENDIENTE</span>\r
                    </p>\r
                  </div>\r
\r
                  <!-- Equipo Visitante -->\r
                  <div class="flex items-center gap-3 flex-1 justify-end">\r
                    <div>\r
                      <p class="text-white text-sm font-semibold text-right">{{ partido.equipoVisitante.nombre }}</p>\r
                      <p class="text-slate-400 text-xs text-right">Visitante</p>\r
                    </div>\r
                    <div class="w-10 h-10 bg-slate-800 rounded-full flex items-center justify-center">\r
                      <img *ngIf="partido.equipoVisitante.escudoUrl" [src]="partido.equipoVisitante.escudoUrl" alt="" class="w-10 h-10 rounded-full object-contain">\r
                      <i *ngIf="!partido.equipoVisitante.escudoUrl" class="fas fa-futbol text-blue-400"></i>\r
                    </div>\r
                  </div>\r
\r
                  <!-- Ver Acta -->\r
                  <button (click)="verActa(partido)" class="ml-4 px-3 py-1 bg-red-600/20 hover:bg-red-600/40 text-red-400 text-xs font-semibold rounded border border-red-500/40 transition-all">\r
                    VER ACTA\r
                  </button>\r
                </div>\r
              </div>\r
            </div>\r
\r
            <!-- Si no hay resultados -->\r
            <div *ngIf="jornadas.length === 0" class="text-center py-12">\r
              <i class="fas fa-inbox text-slate-500 text-4xl mb-3 block"></i>\r
              <p class="text-slate-400 text-lg">No hay partidos registrados en esta liga</p>\r
            </div>\r
          </div>\r
        </div>\r
\r
        <!-- TAB: CLASIFICACI\xD3N -->\r
        <div *ngIf="tabActiva === 'clasificacion'">\r
          <h2 class="text-xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-400 mb-6">\r
            <i class="fas fa-ranking-star mr-2"></i>Clasificaci\xF3n\r
          </h2>\r
\r
          <div *ngIf="clasificacion.length > 0; else sinClasificacion">\r
            <div class="overflow-x-auto">\r
              <table class="w-full text-sm">\r
                <thead>\r
                  <tr class="border-b border-slate-700/60 text-slate-100 font-semibold bg-gradient-to-r from-blue-500/10 to-cyan-500/10">\r
                    <th class="text-left py-3 px-3">POS</th>\r
                    <th class="text-left py-3 px-3">EQUIPO</th>\r
                    <th class="text-center py-3 px-2">PJ</th>\r
                    <th class="text-center py-3 px-2">G</th>\r
                    <th class="text-center py-3 px-2">E</th>\r
                    <th class="text-center py-3 px-2">P</th>\r
                    <th class="text-center py-3 px-2">GF</th>\r
                    <th class="text-center py-3 px-2">GC</th>\r
                    <th class="text-center py-3 px-2">PTS</th>\r
                  </tr>\r
                </thead>\r
                <tbody class="divide-y divide-slate-700/40">\r
                  <tr *ngFor="let equipo of clasificacion; let i = index" [class.bg-yellow-600/10]="i === 0" [class.bg-slate-800/20]="i > 0" class="hover:bg-slate-800/40 transition-colors">\r
                    <td class="py-3 px-3 font-bold" [ngClass]="{'text-yellow-400': i === 0, 'text-slate-300': i > 0}">{{ i + 1 }}</td>\r
                    <td class="py-3 px-3 font-semibold text-white">{{ equipo.nombre }}</td>\r
                    <td class="text-center py-3 px-2 text-slate-300">{{ equipo.partidosJugados }}</td>\r
                    <td class="text-center py-3 px-2 text-green-400 font-semibold">{{ equipo.ganancias }}</td>\r
                    <td class="text-center py-3 px-2 text-amber-400 font-semibold">{{ equipo.empates }}</td>\r
                    <td class="text-center py-3 px-2 text-red-400 font-semibold">{{ equipo.derrotas }}</td>\r
                    <td class="text-center py-3 px-2 text-blue-400">{{ equipo.golesAFavor }}</td>\r
                    <td class="text-center py-3 px-2 text-orange-400">{{ equipo.golesEnContra }}</td>\r
                    <td class="text-center py-3 px-2 font-bold text-cyan-400">{{ equipo.puntos }}</td>\r
                  </tr>\r
                </tbody>\r
              </table>\r
            </div>\r
          </div>\r
          <ng-template #sinClasificacion>\r
            <div class="text-center py-12">\r
              <i class="fas fa-inbox text-slate-500 text-4xl mb-3 block"></i>\r
              <p class="text-slate-400 text-lg">Busca una competici\xF3n para ver la clasificaci\xF3n</p>\r
            </div>\r
          </ng-template>\r
        </div>\r
\r
        <!-- TAB: RESULTADOS -->\r
        <div *ngIf="tabActiva === 'resultados'">\r
          <h2 class="text-xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-orange-400 mb-6">\r
            <i class="fas fa-list-check mr-2"></i>Resultados y jornadas\r
          </h2>\r
\r
          <div *ngIf="resultados.length > 0; else sinResultados" class="space-y-3">\r
            <div *ngFor="let resultado of resultados" class="bg-slate-950/70 border border-slate-700/60 rounded-lg p-4 hover:border-amber-500/60 hover:shadow-md transition-all flex items-center justify-between">\r
              <!-- Equipo Local -->\r
              <div class="flex items-center gap-3 flex-1">\r
                <div class="w-10 h-10 bg-slate-800 rounded-full flex items-center justify-center overflow-hidden">\r
                  <img *ngIf="resultado.escudoLocalUrl" [src]="resultado.escudoLocalUrl" class="w-full h-full object-contain">\r
                  <i *ngIf="!resultado.escudoLocalUrl" class="fas fa-futbol text-amber-400"></i>\r
                </div>\r
                <div>\r
                  <p class="text-white text-sm font-semibold">{{ resultado.equipoLocal }}</p>\r
                  <p class="text-slate-400 text-xs">Local</p>\r
                </div>\r
              </div>\r
\r
              <!-- Resultado -->\r
              <div class="text-center px-4">\r
                <div class="text-2xl font-bold text-amber-400">\r
                  {{ resultado.golesLocal }} - {{ resultado.golesVisitante }}\r
                </div>\r
                <p class="text-slate-400 text-xs mt-1">{{ resultado.fecha | date:'dd/MM/yyyy HH:mm' }}</p>\r
              </div>\r
\r
              <!-- Equipo Visitante -->\r
              <div class="flex items-center gap-3 flex-1 justify-end">\r
                <div>\r
                  <p class="text-white text-sm font-semibold text-right">{{ resultado.equipoVisitante }}</p>\r
                  <p class="text-slate-400 text-xs text-right">Visitante</p>\r
                </div>\r
                <div class="w-10 h-10 bg-slate-800 rounded-full flex items-center justify-center overflow-hidden">\r
                  <img *ngIf="resultado.escudoVisitanteUrl" [src]="resultado.escudoVisitanteUrl" class="w-full h-full object-contain">\r
                  <i *ngIf="!resultado.escudoVisitanteUrl" class="fas fa-futbol text-amber-400"></i>\r
                </div>\r
              </div>\r
            </div>\r
          </div>\r
          <ng-template #sinResultados>\r
            <div class="text-center py-12">\r
              <i class="fas fa-inbox text-slate-500 text-4xl mb-3 block"></i>\r
              <p class="text-slate-400 text-lg">No hay resultados disponibles</p>\r
            </div>\r
          </ng-template>\r
        </div>\r
\r
        <!-- TAB: GOLEADORES -->\r
        <div *ngIf="tabActiva === 'goleadores'">\r
          <h2 class="text-xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-red-400 mb-6">\r
            <i class="fas fa-shoe-prints mr-2"></i>Goleadores\r
          </h2>\r
\r
          <div *ngIf="goleadores.length > 0; else sinGoleadores" class="space-y-3">\r
            <div *ngFor="let goleador of goleadores; let i = index" class="bg-slate-950/70 border border-slate-700/60 rounded-lg p-4 hover:border-orange-500/60 hover:shadow-md transition-all flex items-center justify-between">\r
              <!-- Posici\xF3n -->\r
              <div class="w-12 h-12 rounded-full flex items-center justify-center font-bold text-lg"\r
                [ngClass]="{'bg-yellow-600/30 text-yellow-400': i === 0, 'bg-slate-600/30 text-slate-300': i === 1, 'bg-orange-600/30 text-orange-400': i === 2, 'bg-slate-800/50 text-slate-400': i > 2}">\r
                {{ i + 1 }}\r
              </div>\r
\r
              <!-- Informaci\xF3n del goleador -->\r
              <div class="flex-1 ml-4">\r
                <p class="text-white font-semibold">{{ goleador.nombre }}</p>\r
                <p class="text-slate-400 text-sm">{{ goleador.equipo }}</p>\r
              </div>\r
\r
              <!-- Goles -->\r
              <div class="text-center">\r
                <p class="text-3xl font-bold text-orange-400">{{ goleador.goles }}</p>\r
                <p class="text-slate-400 text-xs"><i class="fas fa-futbol mr-1"></i>Goles</p>\r
              </div>\r
            </div>\r
          </div>\r
\r
          <ng-template #sinGoleadores>\r
            <div class="text-center py-12">\r
              <i class="fas fa-inbox text-slate-500 text-4xl mb-3 block"></i>\r
              <p class="text-slate-400 text-lg">No hay datos de goleadores disponibles</p>\r
            </div>\r
          </ng-template>\r
        </div>\r
\r
      </div>\r
    </div>\r
\r
  </main>\r
</div>\r
\r
<!-- MODAL ACTA -->\r
<div *ngIf="modalActaAbierto" class="fixed inset-0 z-50 flex items-center justify-center p-4" (click)="cerrarActa()">\r
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>\r
  <div class="relative z-10 w-full max-w-lg bg-slate-900 rounded-2xl border border-blue-500/30 p-6 shadow-2xl max-h-[85vh] flex flex-col" (click)="$event.stopPropagation()">\r
\r
    <!-- Cabecera -->\r
    <div class="flex items-center justify-between mb-5">\r
      <h3 class="text-lg font-bold text-white">Acta del Partido</h3>\r
      <button (click)="cerrarActa()" class="text-gray-400 hover:text-white transition">\r
        <i class="fas fa-times text-xl"></i>\r
      </button>\r
    </div>\r
\r
    <!-- Equipos y resultado -->\r
    <div class="flex items-center justify-between bg-slate-800/50 rounded-xl p-4 mb-4 border border-blue-500/20">\r
      <div class="flex items-center gap-3 flex-1">\r
        <div class="w-10 h-10 bg-slate-700 rounded-full flex items-center justify-center overflow-hidden">\r
          <img *ngIf="partidoActa?.equipoLocal?.escudoUrl" [src]="partidoActa?.equipoLocal?.escudoUrl" class="w-10 h-10 rounded-full object-contain">\r
          <i *ngIf="!partidoActa?.equipoLocal?.escudoUrl" class="fas fa-futbol text-red-400"></i>\r
        </div>\r
        <p class="text-white font-bold text-sm">{{ partidoActa?.equipoLocal?.nombre }}</p>\r
      </div>\r
      <div class="text-center px-4">\r
        <p class="text-2xl font-black text-yellow-400">{{ partidoActa?.golesLocal ?? '-' }} - {{ partidoActa?.golesVisitante ?? '-' }}</p>\r
        <p class="text-xs text-gray-400 mt-1">Jornada {{ partidoActa?.jornada }}</p>\r
      </div>\r
      <div class="flex items-center gap-3 flex-1 justify-end">\r
        <p class="text-white font-bold text-sm text-right">{{ partidoActa?.equipoVisitante?.nombre }}</p>\r
        <div class="w-10 h-10 bg-slate-700 rounded-full flex items-center justify-center overflow-hidden">\r
          <img *ngIf="partidoActa?.equipoVisitante?.escudoUrl" [src]="partidoActa?.equipoVisitante?.escudoUrl" class="w-10 h-10 rounded-full object-contain">\r
          <i *ngIf="!partidoActa?.equipoVisitante?.escudoUrl" class="fas fa-futbol text-blue-400"></i>\r
        </div>\r
      </div>\r
    </div>\r
\r
    <!-- \xC1rbitro y fecha -->\r
    <div class="flex gap-4 mb-4 text-xs text-gray-400">\r
      <span><i class="fas fa-whistle mr-1 text-blue-400"></i>{{ partidoActa?.arbitroNombre || 'Sin \xE1rbitro asignado' }}</span>\r
      <span><i class="fas fa-calendar mr-1 text-blue-400"></i>{{ (partidoActa?.fechaHora | date:'dd/MM/yyyy HH:mm') || 'Sin fecha' }}</span>\r
    </div>\r
\r
    <!-- Eventos -->\r
    <div class="overflow-y-auto flex-1">\r
      <div *ngIf="cargandoActa" class="text-center py-8">\r
        <i class="fas fa-spinner animate-spin text-blue-400 text-2xl"></i>\r
      </div>\r
\r
      <div *ngIf="!cargandoActa">\r
        <div *ngIf="eventosActa.length === 0" class="text-center py-8 text-gray-400">\r
          <i class="fas fa-clipboard text-3xl mb-2 block"></i>\r
          No hay eventos registrados en este partido\r
        </div>\r
\r
        <div *ngIf="eventosActa.length > 0">\r
          <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">Eventos</h4>\r
          <div class="space-y-2">\r
            <div *ngFor="let evento of eventosActa" class="flex items-center gap-3 bg-slate-800/40 rounded-lg px-3 py-2">\r
              <span class="text-blue-400 font-bold text-sm w-10 text-right">{{ evento.minuto }}'</span>\r
              <span *ngIf="evento.tipoEvento === 'Gol'" class="text-white"><i class="fas fa-futbol text-yellow-400 mr-1"></i></span>\r
              <span *ngIf="evento.tipoEvento === 'TarjetaAmarilla'" class="text-white"><i class="fas fa-square text-yellow-400 mr-1"></i></span>\r
              <span *ngIf="evento.tipoEvento === 'TarjetaRoja'" class="text-white"><i class="fas fa-square text-red-500 mr-1"></i></span>\r
              <span class="text-white text-sm">{{ evento.nombreJugador }}</span>\r
            </div>\r
