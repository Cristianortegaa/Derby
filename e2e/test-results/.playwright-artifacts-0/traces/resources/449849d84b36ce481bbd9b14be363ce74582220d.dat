P%]:focus {\n  border-color: rgba(59, 130, 246, 0.7);\n}\n.th-cell[_ngcontent-%COMP%] {\n  padding: 0.75rem 1.25rem;\n  text-align: left;\n  font-size: 0.6875rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n}\n.td-cell[_ngcontent-%COMP%] {\n  padding: 0.875rem 1.25rem;\n  font-size: 0.8125rem;\n  vertical-align: middle;\n}\n.action-btn[_ngcontent-%COMP%] {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 2rem;\n  height: 2rem;\n  border-radius: 0.4rem;\n  border: 0.5px solid;\n  cursor: pointer;\n  background: transparent;\n  transition: all 0.15s ease;\n}\n.btn-primary[_ngcontent-%COMP%] {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.375rem;\n  padding: 0.5rem 1rem;\n  background:\n    linear-gradient(\n      135deg,\n      #ef4444,\n      #dc2626);\n  color: #fff;\n  font-size: 0.8125rem;\n  font-weight: 700;\n  border-radius: 0.5rem;\n  border: none;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n.btn-primary[_ngcontent-%COMP%]:hover {\n  background:\n    linear-gradient(\n      135deg,\n      #dc2626,\n      #b91c1c);\n  transform: scale(1.02);\n}\n.btn-secondary[_ngcontent-%COMP%] {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.375rem;\n  padding: 0.5rem 1rem;\n  background: rgba(30, 41, 59, 0.8);\n  color: #e2e8f0;\n  font-size: 0.8125rem;\n  font-weight: 600;\n  border-radius: 0.5rem;\n  border: 0.5px solid rgba(100, 116, 139, 0.4);\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n.btn-secondary[_ngcontent-%COMP%]:hover {\n  border-color: rgba(100, 116, 139, 0.7);\n  background: rgba(30, 41, 59, 1);\n}\n/*# sourceMappingURL=admin-equipos.css.map */"] });
