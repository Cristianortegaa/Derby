(() => {
  (typeof ngDevMode === "undefined" || ngDevMode) && i016.\u0275setClassMetadata(AdminPartidosComponent, [{
    type: Component12,
    args: [{ selector: "app-admin-partidos", standalone: true, imports: [CommonModule12, FormsModule7, RouterLink9, NavbarComponent], template: `<div class="w-full min-h-screen flex flex-col bg-gradient-to-br from-slate-950 via-slate-950 to-slate-900 text-white relative">\r
\r
  <app-navbar></app-navbar>\r
  <div class="h-20"></div>\r
\r
  <div class="absolute top-0 left-0 w-96 h-96 bg-blue-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-red-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
\r
  <div class="relative z-10 px-6 md:px-12 py-8 max-w-7xl mx-auto w-full">\r
\r
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">\r
      <div>\r
        <h1 class="text-3xl md:text-4xl font-black mb-1 text-white">Gestionar Partidos</h1>\r
        <p class="text-gray-500 text-sm font-medium">Crea, edita y gestiona todos los partidos</p>\r
        <div class="h-1 w-16 bg-gradient-to-r from-red-400 to-blue-400 mt-3 rounded-full"></div>\r
      </div>\r
\r
      <div class="flex items-center gap-3">\r
        <a *ngIf="ligaIdFijado"\r
           [routerLink]="['/admin/ligas', ligaIdFijado]"\r
           class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-green-500/40 rounded-lg text-white hover:border-green-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
          <i class="fas fa-arrow-left"></i> Volver a Liga\r
        </a>\r
        <a *ngIf="competicionIdFijado && !ligaIdFijado"\r
           [routerLink]="['/admin/competiciones', competicionIdFijado]"\r
           class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-green-500/40 rounded-lg text-white hover:border-green-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
          <i class="fas fa-arrow-left"></i> Volver a Competici\xF3n\r
        </a>\r
        <a *ngIf="!competicionIdFijado && !ligaIdFijado" routerLink="/admin"\r
           class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-blue-500/40 rounded-lg text-white hover:border-blue-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
          <i class="fas fa-arrow-left"></i> Volver\r
        </a>\r
      </div>\r
    </div>\r
\r
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">\r
      <div class="bg-slate-900/80 border border-blue-500/20 rounded-xl p-4">\r
        <div class="text-xs text-gray-500 font-semibold uppercase mb-1"><i class="fas fa-chart-bar mr-1"></i>Total</div>\r
        <div class="text-3xl font-black text-white">{{ partidos.length }}</div>\r
      </div>\r
      <div class="bg-slate-900/80 border border-blue-500/20 rounded-xl p-4">\r
        <div class="text-xs text-gray-500 font-semibold uppercase mb-1"><i class="fas fa-clock mr-1"></i>Pendientes</div>\r
        <div class="text-3xl font-black text-yellow-400">{{ partidosPendientes }}</div>\r
      </div>\r
      <div class="bg-slate-900/80 border border-blue-500/20 rounded-xl p-4">\r
        <div class="text-xs text-gray-500 font-semibold uppercase mb-1"><i class="fas fa-circle text-red-400 mr-1"></i>En juego</div>\r
        <div class="text-3xl font-black text-red-400">{{ partidosEnJuego }}</div>\r
      </div>\r
      <div class="bg-slate-900/80 border border-blue-500/20 rounded-xl p-4">\r
        <div class="text-xs text-gray-500 font-semibold uppercase mb-1"><i class="fas fa-check-circle mr-1"></i>Finalizados</div>\r
        <div class="text-3xl font-black text-green-400">{{ partidosFinalizados }}</div>\r
      </div>\r
    </div>\r
\r
    <div *ngIf="mostrarForm" class="bg-slate-900/80 border border-blue-500/30 rounded-xl p-8 mb-6">\r
      <h2 class="text-xl font-bold text-white mb-6"><i class="fas mr-2" [ngClass]="editandoId ? 'fa-pen-to-square' : 'fa-plus'"></i>{{ editandoId ? 'Editar Partido' : 'Nuevo Partido' }}</h2>\r
\r
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">\r
        <div>\r
          <label class="block text-white text-sm font-semibold mb-2">Liga <span class="text-red-400">*</span></label>\r
          <select [(ngModel)]="formulario.ligaId" name="liga" class="w-full px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white focus:border-blue-400 outline-none">\r
            <option [ngValue]="0">Seleccionar liga...</option>\r
            <option *ngFor="let liga of ligas" [ngValue]="liga.id">{{ liga.nombre }}</option>\r
          </select>\r
        </div>\r
\r
        <div>\r
          <label class="block text-white text-sm font-semibold mb-2">Jornada <span class="text-red-400">*</span></label>\r
          <input type="number" [(ngModel)]="formulario.jornada" name="jornada" min="1" class="w-full px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white focus:border-blue-400 outline-none"/>\r
        </div>\r
\r
        <div>\r
          <label class="block text-white text-sm font-semibold mb-2">Equipo Local <span class="text-red-400">*</span></label>\r
          <select [(ngModel)]="formulario.equipoLocalId" name="equipoLocal" class="w-full px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white focus:border-blue-400 outline-none">\r
            <option [ngValue]="0">Seleccionar equipo...</option>\r
            <option *ngFor="let equipo of equipos" [ngValue]="equipo.id">{{ equipo.nombre }}</option>\r
          </select>\r
        </div>\r
\r
        <div>\r
          <label class="block text-white text-sm font-semibold mb-2">Equipo Visitante <span class="text-red-400">*</span></label>\r
          <select [(ngModel)]="formulario.equipoVisitanteId" name="equipoVisitante" class="w-full px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white focus:border-blue-400 outline-none">\r
            <option [ngValue]="0">Seleccionar equipo...</option>\r
            <option *ngFor="let equipo of equipos" [ngValue]="equipo.id">{{ equipo.nombre }}</option>\r
          </select>\r
        </div>\r
\r
        <div>\r
          <label class="block text-white text-sm font-semibold mb-2">Fecha y Hora</label>\r
          <input type="datetime-local" [(ngModel)]="formulario.fechaHora" name="fechaHora" class="w-full px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white focus:border-blue-400 outline-none"/>\r
        </div>\r
\r
        <div>\r
          <label class="block text-white text-sm font-semibold mb-2">\xC1rbitro</label>\r
          <select [(ngModel)]="formulario.arbitroId" name="arbitro" class="w-full px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white focus:border-blue-400 outline-none">\r
            <option [ngValue]="undefined">Sin asignar</option>\r
            <option *ngFor="let arbitro of arbitros" [ngValue]="arbitro.id">{{ arbitro.nombre }} {{ arbitro.apellidos }}</option>\r
          </select>\r
        </div>\r
\r
        <div>\r
          <label class="block text-white text-sm font-semibold mb-2">Goles Local</label>\r
          <input type="number" [(ngModel)]="formulario.golesLocal" name="golesLocal" min="0" class="w-full px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white focus:border-blue-400 outline-none"/>\r
        </div>\r
\r
        <div>\r
          <label class="block text-white text-sm font-semibold mb-2">Goles Visitante</label>\r
          <input type="number" [(ngModel)]="formulario.golesVisitante" name="golesVisitante" min="0" class="w-full px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white focus:border-blue-400 outline-none"/>\r
        </div>\r
\r
        <div>\r
          <label class="block text-white text-sm font-semibold mb-2">Estado</label>\r
          <select [(ngModel)]="formulario.estado" name="estado" class="w-full px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white focus:border-blue-400 outline-none">\r
            <option value="Pendiente">Pendiente</option>\r
            <option value="En juego">En juego</option>\r
            <option value="Finalizado">Finalizado</option>\r
            <option value="Suspendido">Suspendido</option>\r
            <option value="Aplazado">Aplazado</option>\r
          </select>\r
        </div>\r
      </div>\r
\r
      <div class="flex gap-3 justify-end mt-6">\r
        <button (click)="cerrarForm()" class="px-6 py-2 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-lg">Cancelar</button>\r
        <button (click)="guardar()" class="px-6 py-2 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-semibold rounded-lg">{{ editandoId ? 'Actualizar' : 'Crear' }}</button>\r
      </div>\r
    </div>\r
\r
    <div class="bg-slate-900/80 border border-blue-500/20 rounded-xl p-6">\r
      <div class="mb-6 flex items-center justify-between">\r
        <h2 class="text-lg font-bold text-red-400"><i class="fas fa-futbol mr-2"></i>Partidos ({{ partidosFiltrados.length }})</h2>\r
        <div class="flex flex-wrap gap-3 items-center">\r
          <select [(ngModel)]="filtroLiga" (change)="aplicarFiltros()" name="filtroLiga" class="px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 outline-none">\r
            <option [ngValue]="">Todas las ligas</option>\r
            <option *ngFor="let liga of ligas" [ngValue]="liga.id">{{ liga.nombre }}</option>\r
          </select>\r
\r
          <select [(ngModel)]="filtroEstado" (change)="aplicarFiltros()" name="filtroEstado" class="px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 outline-none">\r
            <option value="">Todos los estados</option>\r
            <option value="Pendiente">Pendiente</option>\r
            <option value="En juego">En juego</option>\r
            <option value="Finalizado">Finalizado</option>\r
            <option value="Suspendido">Suspendido</option>\r
          </select>\r
\r
          <button *ngIf="!mostrarForm" (click)="abrirForm()" class="px-4 py-2 bg-gradient-to-r from-red-600 to-red-700 text-white font-semibold rounded-lg">+ Nuevo</button>\r
        </div>\r
      </div>\r
\r
      <div *ngIf="cargando" class="text-center py-8">\r
        <p class="text-gray-400">Cargando partidos...</p>\r
      </div>\r
\r
      <div *ngIf="!cargando && partidosFiltrados.length === 0" class="text-center py-8">\r
        <i class="fas fa-inbox text-4xl text-gray-600 mb-3"></i>\r
        <p class="text-gray-400">No hay partidos</p>\r
      </div>\r
\r
      <div *ngIf="!cargando && partidosFiltrados.length > 0" class="overflow-x-auto">\r
        <table class="w-full">\r
          <thead>\r
          <tr class="border-b border-slate-700/50">\r
            <th class="text-left py-3 px-4 text-yellow-400 font-bold">Jornada</th>\r
            <th class="text-left py-3 px-4 text-white font-bold">Local</th>\r
            <th class="text-left py-3 px-4 text-white font-bold">Visitante</th>\r
            <th class="text-center py-3 px-4 text-green-400 font-bold">Resultado</th>\r
            <th class="text-left py-3 px-4 text-gray-400 font-bold">Fecha</th>\r
            <th class="text-left py-3 px-4 text-amber-400 font-bold">Estado</th>\r
            <th class="text-left py-3 px-4 text-blue-400 font-bold">\xC1rbitro</th>\r
            <th class="text-center py-3 px-4 text-red-400 font-bold">Acciones</th>\r
          </tr>\r
          </thead>\r
          <tbody>\r
          <tr *ngFor="let partido of partidosFiltrados" class="border-b border-slate-700/30 hover:bg-slate-800/50">\r
            <td class="py-3 px-4 text-yellow-400 font-bold">J{{ partido.jornada }}</td>\r
            <td class="py-3 px-4 text-white font-semibold">{{ partido.equipoLocal?.nombre || 'N/A' }}</td>\r
            <td class="py-3 px-4 text-white font-semibold">{{ partido.equipoVisitante?.nombre || 'N/A' }}</td>\r
            <td class="py-3 px-4 text-center text-green-400 font-bold text-lg">{{ partido.golesLocal }} - {{ partido.golesVisitante }}</td>\r
            <td class="py-3 px-4 text-gray-400 text-sm">{{ partido.fechaHora ? (partido.fechaHora | date: 'dd/MM/yyyy HH:mm') : 'Sin fecha' }}</td>\r
            <td class="py-3 px-4">\r
              <span class="px-2 py-1 rounded text-xs font-bold"\r
                    [ngClass]="{\r
                  'bg-yellow-500/20 text-yellow-400': partido.estado === 'Pendiente',\r
                  'bg-red-500/20 text-red-400': partido.estado === 'En juego',\r
                  'bg-green-500/20 text-green-400': partido.estado === 'Finalizado',\r
                  'bg-gray-500/20 text-gray-400': partido.estado === 'Suspendido'\r
                }">\r
                {{ partido.estado }}\r
              </span>\r
            </td>\r
            <td class="py-3 px-4">\r
              <select [(ngModel)]="partido.arbitroId" (change)="asignarArbitro(partido)"\r
                class="px-3 py-1 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 outline-none">\r
                <option [ngValue]="null">Sin asignar</option>\r
                <option *ngFor="let arbitro of arbitros" [ngValue]="arbitro.id">{{ arbitro.nombre }} {{ arbitro.apellidos }}</option>\r
              </select>\r
            </td>\r
            <td class="py-3 px-4 text-center flex gap-2 justify-center">\r
              <button (click)="abrirForm(partido)" class="px-3 py-1 text-blue-300 border border-blue-500/40 rounded hover:bg-blue-500/20 text-xs">\r
                <i class="fas fa-edit"></i>\r
              </button>\r
              <button (click)="eliminar(partido.id!, obtenerDescripcionPartido(partido))" class="px-3 py-1 text-red-300 border border-red-500/40 rounded hover:bg-red-500/20 text-xs">\r
                <i class="fas fa-trash"></i>\r
              </button>\r
            </td>\r
          </tr>\r
          </tbody>\r
        </table>\r
      </div>\r
    </div>\r
\r
  </div>\r
\r
  <div *ngIf="notificacion.mostrar" class="fixed bottom-6 right-6 z-50 px-5 py-3 rounded-xl text-sm font-semibold shadow-2xl"\r
       [ngClass]="notificacion.tipo === 'exito' ? 'bg-green-500/90 text-white' : 'bg-red-500/90 text-white'">\r
    {{ notificacion.mensaje }}\r
  </div>\r
\r
  <!-- Modal confirmaci\xF3n -->\r
  <div *ngIf="modalConfirm.mostrar"\r
       class="fixed inset-0 z-50 flex items-center justify-center p-4"\r
       (click)="cerrarConfirm()">\r
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>\r
    <div class="relative z-10 w-full max-w-md bg-slate-900 rounded-2xl border border-red-500/30 p-6 shadow-2xl"\r
         (click)="$event.stopPropagation()">\r
      <div class="flex items-center justify-center w-14 h-14 rounded-full bg-red-500/15 border border-red-500/30 mx-auto mb-5">\r
        <i class="fas fa-triangle-exclamation text-red-400 text-xl"></i>\r
      </div>\r
      <h3 class="text-lg font-bold text-white text-center mb-2">{{ modalConfirm.titulo }}</h3>\r
      <p class="text-gray-400 text-sm text-center leading-relaxed mb-6">{{ modalConfirm.mensaje }}</p>\r
      <div class="flex gap-3">\r
        <button (click)="cerrarConfirm()" class="flex-1 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-lg border border-slate-600 transition-all">\r
          Cancelar\r
        </button>\r
        <button (click)="confirmar()" class="flex-1 px-4 py-2 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-semibold rounded-lg transition-all">\r
          <i class="fas fa-trash text-xs mr-1"></i> {{ modalConfirm.textoConfirmar }}\r
        </button>\r
      </div>\r
    </div>\r
  </div>\r
\r
</div>\r
\r
` }]
