    type: Component13,
    args: [{ selector: "app-admin-goleadores", standalone: true, imports: [CommonModule13, FormsModule8, RouterLink10, NavbarComponent], template: `<div class="w-full min-h-screen flex flex-col bg-gradient-to-br from-slate-950 via-slate-950 to-slate-900 text-white relative">\r
\r
  <app-navbar></app-navbar>\r
  <div class="h-20"></div>\r
\r
  <div class="absolute top-0 left-0 w-96 h-96 bg-blue-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-red-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
\r
  <div class="relative z-10 px-6 md:px-12 py-8 max-w-7xl mx-auto w-full">\r
\r
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">\r
      <div>\r
        <h1 class="text-3xl md:text-4xl font-black mb-1 text-white">Goleadores</h1>\r
        <p class="text-gray-500 text-sm font-medium">Estad\xEDsticas de goleadores por liga</p>\r
        <div class="h-1 w-16 bg-gradient-to-r from-red-400 to-blue-400 mt-3 rounded-full"></div>\r
      </div>\r
\r
      <div class="flex items-center gap-3">\r
        <a *ngIf="ligaIdFijado"\r
           [routerLink]="['/admin/ligas', ligaIdFijado]"\r
           class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-green-500/40 rounded-lg text-white hover:border-green-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
          <i class="fas fa-arrow-left"></i> Volver a Liga\r
        </a>\r
        <a *ngIf="competicionIdFijado && !ligaIdFijado"\r
           [routerLink]="['/admin/competiciones', competicionIdFijado]"\r
           class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-green-500/40 rounded-lg text-white hover:border-green-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
          <i class="fas fa-arrow-left"></i> Volver a Competici\xF3n\r
        </a>\r
        <a *ngIf="!competicionIdFijado && !ligaIdFijado" routerLink="/admin"\r
           class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-blue-500/40 rounded-lg text-white hover:border-blue-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
          <i class="fas fa-arrow-left"></i> Volver\r
        </a>\r
      </div>\r
    </div>\r
\r
    <div class="bg-slate-900/80 border border-blue-500/20 rounded-xl p-6">\r
      <div class="mb-6 flex items-center justify-between">\r
        <h2 class="text-lg font-bold text-red-400"><i class="fas fa-futbol mr-2"></i>Top Goleadores ({{ goleadoresFiltrados.length }})</h2>\r
        <div class="relative">\r
          <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 text-sm"></i>\r
          <input type="text" [(ngModel)]="busquedaBuscador" (input)="aplicarFiltro()" placeholder="Buscar goleador..."\r
                 class="pl-10 pr-4 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 outline-none w-64"/>\r
        </div>\r
      </div>\r
\r
      <div *ngIf="cargando" class="text-center py-8">\r
        <p class="text-gray-400">Cargando goleadores...</p>\r
      </div>\r
\r
      <div *ngIf="!cargando && goleadoresFiltrados.length === 0" class="text-center py-8">\r
        <i class="fas fa-inbox text-4xl text-gray-600 mb-3"></i>\r
        <p class="text-gray-400">No hay goleadores registrados</p>\r
      </div>\r
\r
      <div *ngIf="!cargando && goleadoresFiltrados.length > 0" class="overflow-x-auto">\r
        <table class="w-full">\r
          <thead>\r
          <tr class="border-b border-slate-700/50">\r
            <th class="text-left py-3 px-4 text-blue-400 font-bold">Pos</th>\r
            <th class="text-left py-3 px-4 text-white font-bold">Jugador</th>\r
            <th class="text-left py-3 px-4 text-green-400 font-bold">Equipo</th>\r
            <th class="text-center py-3 px-4 text-yellow-400 font-bold">Goles</th>\r
          </tr>\r
          </thead>\r
          <tbody>\r
          <tr *ngFor="let goleador of goleadoresFiltrados; let i = index" class="border-b border-slate-700/30 hover:bg-slate-800/50">\r
            <td class="py-3 px-4 font-bold text-yellow-400">{{ i + 1 }}</td>\r
            <td class="py-3 px-4 text-white font-semibold">{{ goleador.nombre || 'N/A' }}</td>\r
            <td class="py-3 px-4 text-green-400">{{ goleador.equipo || 'N/A' }}</td>\r
            <td class="py-3 px-4 text-center font-bold text-yellow-400 text-lg">{{ goleador.goles || 0 }}</td>\r
          </tr>\r
          </tbody>\r
        </table>\r
      </div>\r
    </div>\r
\r
  </div>\r
\r
</div>\r
\r
`, styles: ["/* src/app/components/components/admin/admin-goleadores/admin-goleadores.css */\n/*# sourceMappingURL=admin-goleadores.css.map */\n"] }]
