  <div class="relative z-10 px-6 md:px-12 py-8 max-w-7xl mx-auto w-full">\r
\r
    <!-- Header -->\r
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">\r
      <div>\r
        <p class="text-gray-500 text-xs font-semibold uppercase tracking-widest mb-1">Competici\xF3n</p>\r
        <h1 class="text-3xl md:text-4xl font-black mb-1 text-white">\r
          <span *ngIf="cargando">Cargando...</span>\r
          <span *ngIf="!cargando && competicion">{{ competicion.nombre }}</span>\r
          <span *ngIf="!cargando && !competicion">Competici\xF3n no encontrada</span>\r
        </h1>\r
        <div class="flex items-center gap-3 mt-2" *ngIf="competicion">\r
          <span class="text-gray-500 text-sm">{{ competicion.temporada }}</span>\r
          <span class="text-gray-600">\xB7</span>\r
          <span class="text-gray-500 text-sm">{{ competicion.tipo || 'Liga' }}</span>\r
          <span class="text-gray-600">\xB7</span>\r
          <span class="badge" [ngClass]="getBadgeClase(competicion.estado)">\r
            <span class="dot" [ngClass]="'dot-' + competicion.estado?.toLowerCase()"></span>\r
            {{ competicion.estado }}\r
          </span>\r
        </div>\r
        <div class="h-1 w-16 bg-gradient-to-r from-blue-400 to-red-400 mt-3 rounded-full"></div>\r
      </div>\r
      <div class="flex items-center gap-3">\r
        <a routerLink="/admin/competiciones"\r
           class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-blue-500/40 rounded-lg text-white hover:border-blue-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
          <i class="fas fa-arrow-left"></i> Volver a Competiciones\r
        </a>\r
      </div>\r
    </div>\r
\r
    <!-- Loading -->\r
    <div *ngIf="cargando" class="flex flex-col items-center justify-center py-24">\r
      <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-blue-500 mb-4"></div>\r
      <p class="text-gray-500 text-sm">Cargando competici\xF3n...</p>\r
    </div>\r
\r
    <!-- Not found -->\r
    <div *ngIf="!cargando && !competicion" class="flex flex-col items-center justify-center py-24 text-center">\r
      <i class="fas fa-circle-xmark text-5xl text-red-500/40 mb-4"></i>\r
      <p class="text-gray-400 font-semibold text-lg">Competici\xF3n no encontrada</p>\r
      <a routerLink="/admin/competiciones" class="mt-4 text-blue-400 hover:text-blue-300 text-sm"><i class="fas fa-arrow-left mr-1"></i> Volver a la\r
        lista</a>\r
    </div>\r
\r
    <!-- Contenido principal -->\r
    <div *ngIf="!cargando && competicion">\r
\r
      <!-- Texto gu\xEDa -->\r
      <div class="mb-8 text-center">\r
        <p class="text-gray-500 text-sm">Selecciona una secci\xF3n para gestionar esta competici\xF3n</p>\r
      </div>\r
\r
      <!-- Card central grande -->\r
      <div class="flex justify-center">\r
        <a [routerLink]="['/admin/ligas']" [queryParams]="{ competicionId: competicionId }"\r
           class="group relative w-full max-w-xl bg-gradient-to-br from-yellow-900/40 to-yellow-800/20 border border-yellow-500/40 rounded-2xl p-10 hover:border-yellow-400/80 hover:shadow-2xl hover:shadow-yellow-500/20 transition-all duration-300 cursor-pointer overflow-hidden">\r
\r
          <!-- Fondo decorativo -->\r
          <div class="absolute top-0 right-0 w-48 h-48 bg-yellow-500/5 rounded-full blur-2xl pointer-events-none group-hover:bg-yellow-500/10 transition-all"></div>\r
\r
          <div class="relative flex flex-col items-center text-center gap-5">\r
            <div class="w-20 h-20 bg-yellow-500/20 rounded-2xl flex items-center justify-center group-hover:bg-yellow-500/40 transition-colors">\r
              <i class="fas fa-list text-yellow-400 text-3xl"></i>\r
            </div>\r
            <div>\r
              <h3 class="text-2xl font-black text-white mb-2">Ligas</h3>\r
              <p class="text-gray-400 text-sm leading-relaxed">Gestiona las ligas, grupos y jornadas de esta competici\xF3n.<br>Desde cada liga podr\xE1s acceder a partidos, clasificaci\xF3n y m\xE1s.</p>\r
            </div>\r
            <div class="flex items-center gap-2 px-5 py-2.5 bg-yellow-500/20 border border-yellow-500/40 rounded-lg text-yellow-400 text-sm font-bold group-hover:bg-yellow-500/30 group-hover:border-yellow-400/60 transition-all">\r
              Gestionar Ligas <i class="fas fa-arrow-right text-xs"></i>\r
            </div>\r
          </div>\r
        </a>\r
      </div>\r
\r
    </div>\r
  </div>\r
</div>\r
`, styles: ["/* src/app/components/components/admin/admin-competicion-detail/admin-competicion-detail.css */\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.375rem;\n  padding: 0.25rem 0.75rem;\n  border-radius: 9999px;\n  font-size: 0.6875rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\n.badge-activo {\n  background: rgba(34, 197, 94, .15);\n  color: #4ade80;\n  border: 1px solid rgba(34, 197, 94, .3);\n}\n.badge-inactivo {\n  background: rgba(100, 116, 139, .15);\n  color: #94a3b8;\n  border: 1px solid rgba(100, 116, 139, .3);\n}\n.badge-pausado {\n  background: rgba(234, 179, 8, .15);\n  color: #facc15;\n  border: 1px solid rgba(234, 179, 8, .3);\n}\n.badge-finalizado {\n  background: rgba(59, 130, 246, .15);\n  color: #60a5fa;\n  border: 1px solid rgba(59, 130, 246, .3);\n}\n.dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 9999px;\n  display: inline-block;\n}\n.dot-activo {\n  background: #4ade80;\n}\n.dot-inactivo {\n  background: #94a3b8;\n}\n.dot-pausado {\n  background: #facc15;\n}\n.dot-finalizado {\n  background: #60a5fa;\n}\n/*# sourceMappingURL=admin-competicion-detail.css.map */\n"] }]
