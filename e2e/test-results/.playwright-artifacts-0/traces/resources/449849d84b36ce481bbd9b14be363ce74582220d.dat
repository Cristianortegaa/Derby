(() => {
  (typeof ngDevMode === "undefined" || ngDevMode) && i021.\u0275setClassMetadata(AdminEquipos, [{
    type: Component17,
    args: [{ selector: "app-admin-equipos", standalone: true, imports: [CommonModule17, FormsModule11, RouterLink14, NavbarComponent], template: `<div class="w-full min-h-screen flex flex-col bg-gradient-to-br from-slate-950 via-slate-950 to-slate-900 text-white relative">\r
\r
  <app-navbar></app-navbar>\r
  <div class="h-20"></div>\r
\r
  <div class="absolute top-0 left-0 w-80 h-80 bg-blue-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
  <div class="absolute bottom-0 right-0 w-80 h-80 bg-red-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>\r
\r
  <div class="relative z-10 px-6 md:px-12 py-6 max-w-7xl mx-auto w-full">\r
    <div class="flex items-center justify-between">\r
      <div>\r
        <h1 class="text-3xl md:text-4xl font-black mb-2 text-white mt-2">Gestionar Equipos</h1>\r
        <p class="text-gray-500 text-sm md:text-base font-medium">Crea y gestiona los equipos participantes</p>\r
        <div class="h-1 w-16 bg-gradient-to-r from-red-400 to-blue-400 mt-3 rounded-full"></div>\r
      </div>\r
      <div class="flex items-center gap-3">\r
        <button routerLink="/admin"\r
                class="flex items-center gap-2 px-4 py-2 bg-slate-900/80 border border-blue-500/40 rounded-lg text-white hover:border-blue-400/80 hover:bg-slate-800 transition-all text-sm font-semibold">\r
          <i class="fas fa-arrow-left"></i> Volver\r
        </button>\r
        <button *ngIf="!mostrarForm" (click)="mostrarForm = true"\r
                class="px-6 py-2 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-semibold rounded-lg transition-all">\r
          <i class="fas fa-plus mr-2"></i>Nuevo Equipo\r
        </button>\r
      </div>\r
    </div>\r
  </div>\r
\r
  <main class="relative z-10 flex-1 px-6 md:px-12 pb-20 max-w-7xl mx-auto w-full">\r
\r
    <!-- FORMULARIO -->\r
    <div *ngIf="mostrarForm" class="bg-slate-900/80 backdrop-blur-md border border-blue-500/40 rounded-xl p-6 shadow-lg mb-6">\r
      <h2 class="text-lg font-bold text-red-400 mb-4">Nuevo Equipo</h2>\r
\r
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">\r
        <input type="text" [(ngModel)]="formulario.nombre" placeholder="Nombre del equipo"\r
               class="px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 focus:outline-none"/>\r
        <input type="text" [(ngModel)]="formulario.sede" placeholder="Sede"\r
               class="px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 focus:outline-none"/>\r
        <input type="text" [(ngModel)]="formulario.entrenador" placeholder="Entrenador"\r
               class="px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 focus:outline-none"/>\r
      </div>\r
      <div class="flex items-center gap-4 mb-6">\r
        <label class="flex items-center gap-2 px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-gray-400 text-sm cursor-pointer hover:border-blue-400 transition-all">\r
          <i class="fas fa-image text-blue-400"></i> Subir escudo\r
          <input type="file" accept="image/*" class="hidden" (change)="onEscudoSeleccionado($event, 'nuevo')"/>\r
        </label>\r
        <img *ngIf="formulario.escudoUrl" [src]="formulario.escudoUrl" class="w-12 h-12 rounded-full object-cover border border-blue-500/40"/>\r
        <span *ngIf="!formulario.escudoUrl" class="text-gray-600 text-xs">Sin escudo</span>\r
      </div>\r
\r
      <div class="mb-4">\r
        <div class="flex items-center justify-between mb-3">\r
          <p class="text-white text-sm font-semibold">\r
            Jugadores <span class="text-gray-500 font-normal">({{ jugadoresNuevos.length }}/25 \u2014 m\xEDnimo 13)</span>\r
          </p>\r
          <button (click)="agregarJugadorForm()"\r
                  [disabled]="jugadoresNuevos.length >= 25"\r
                  class="px-3 py-1 bg-blue-600 hover:bg-blue-500 disabled:opacity-50 disabled:cursor-not-allowed text-white text-xs font-semibold rounded-lg">\r
            <i class="fas fa-plus mr-1"></i>A\xF1adir jugador\r
          </button>\r
        </div>\r
\r
        <div class="space-y-2">\r
          <div *ngFor="let jugador of jugadoresNuevos; let i = index"\r
               class="flex items-center gap-3">\r
            <span class="text-gray-500 text-xs w-5 text-right">{{ i + 1 }}</span>\r
            <input type="text" [(ngModel)]="jugador.nombre" placeholder="Nombre del jugador"\r
                   class="flex-1 px-3 py-2 bg-slate-950/70 border border-slate-700/50 rounded-lg text-white text-sm focus:border-blue-400 focus:outline-none"/>\r
            <input type="number" [(ngModel)]="jugador.dorsal" placeholder="Dorsal" min="1" max="99"\r
                   class="w-20 px-3 py-2 bg-slate-950/70 border border-slate-700/50 rounded-lg text-white text-sm focus:border-blue-400 focus:outline-none"/>\r
            <button *ngIf="jugadoresNuevos.length > 1" (click)="quitarJugador(i)"\r
                    class="text-red-400 hover:text-red-300 text-xs px-2 py-2">\r
              <i class="fas fa-times"></i>\r
            </button>\r
          </div>\r
        </div>\r
      </div>\r
\r
      <div class="flex gap-3 justify-end mt-6">\r
        <button (click)="mostrarForm = false; resetFormulario()" class="btn-secondary">Cancelar</button>\r
        <button (click)="agregarEquipo()" class="btn-primary">\r
          <i class="fas fa-check"></i> Guardar\r
        </button>\r
      </div>\r
    </div>\r
\r
    <!-- FORMULARIO EDITAR -->\r
    <div *ngIf="mostrarFormEditar" id="formEditar" class="bg-slate-900/80 backdrop-blur-md border border-blue-500/40 rounded-xl p-6 shadow-lg mb-6">\r
      <h2 class="text-lg font-bold text-blue-400 mb-4"><i class="fas fa-pen-to-square mr-2"></i>Editar Equipo</h2>\r
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">\r
        <input type="text" [(ngModel)]="formularioEditar.nombre" placeholder="Nombre del equipo"\r
               class="px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 focus:outline-none"/>\r
        <input type="text" [(ngModel)]="formularioEditar.sede" placeholder="Sede"\r
               class="px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-white text-sm focus:border-blue-400 focus:outline-none"/>\r
      </div>\r
      <div class="flex items-center gap-4 mb-4">\r
        <label class="flex items-center gap-2 px-3 py-2 bg-slate-950/70 border border-blue-500/40 rounded-lg text-gray-400 text-sm cursor-pointer hover:border-blue-400 transition-all">\r
          <i class="fas fa-image text-blue-400"></i> Cambiar escudo\r
          <input type="file" accept="image/*" class="hidden" (change)="onEscudoSeleccionado($event, 'editar')"/>\r
        </label>\r
        <img *ngIf="formularioEditar.escudoUrl" [src]="formularioEditar.escudoUrl" class="w-12 h-12 rounded-full object-cover border border-blue-500/40"/>\r
        <span *ngIf="!formularioEditar.escudoUrl" class="text-gray-600 text-xs">Sin escudo</span>\r
      </div>\r
      <div class="flex gap-3 justify-end mt-6">\r
        <button (click)="cerrarEditar()" class="btn-secondary">Cancelar</button>\r
        <button (click)="actualizarEquipo()" class="btn-primary">\r
          <i class="fas fa-save"></i> Actualizar\r
        </button>\r
      </div>\r
    </div>\r
\r
    <!-- BUSCADOR Y FILTROS -->\r
    <div class="flex flex-wrap gap-3 items-center mb-4">\r
      <div class="search-box">\r
        <i class="fas fa-search text-gray-500 text-xs"></i>\r
        <input type="text" [(ngModel)]="busqueda" (input)="aplicarFiltro()"\r
               placeholder="Buscar por nombre..." class="search-input"/>\r
      </div>\r
      <select [(ngModel)]="filtroLiga" (change)="aplicarFiltro()" class="filter-select">\r
        <option value="">Todas las ligas</option>\r
        <option *ngFor="let liga of ligas" [value]="liga">{{ liga }}</option>\r
      </select>\r
    </div>\r
\r
    <!-- TABLA DE EQUIPOS -->\r
    <div class="bg-slate-900/80 backdrop-blur-md border border-blue-500/40 rounded-xl p-6 shadow-lg overflow-x-auto">\r
      <div *ngIf="equiposFiltrados.length === 0" class="text-center py-8">\r
        <i class="fas fa-inbox text-4xl text-gray-600 mb-3"></i>\r
        <p class="text-gray-400">No hay equipos registrados</p>\r
      </div>\r
      <table *ngIf="equiposFiltrados.length > 0" class="w-full">\r
        <thead>\r
        <tr class="border-b border-slate-700/50">\r
          <th class="th-cell text-gray-400" style="width:56px"></th>\r
          <th class="th-cell text-red-400">Nombre</th>\r
          <th class="th-cell text-blue-400">Sede</th>\r
          <th class="th-cell text-purple-400">Liga</th>\r
          <th class="th-cell text-gray-400" style="text-align:center">Acciones</th>\r
        </tr>\r
        </thead>\r
        <tbody>\r
        <tr *ngFor="let equipo of equiposFiltrados"\r
            class="border-b border-slate-700/30 hover:bg-slate-800/40 transition-colors">\r
          <td class="td-cell">\r
            <img *ngIf="equipo.escudoUrl" [src]="equipo.escudoUrl" class="w-9 h-9 min-w-[36px] min-h-[36px] aspect-square rounded-full object-cover border border-slate-600"/>\r
            <div *ngIf="!equipo.escudoUrl" class="w-9 h-9 min-w-[36px] min-h-[36px] rounded-full bg-slate-700 flex items-center justify-center shrink-0">\r
              <i class="fas fa-shield-halved text-slate-500 text-xs"></i>\r
            </div>\r
          </td>\r
          <td class="td-cell font-semibold text-white">{{ equipo.nombre }}</td>\r
          <td class="td-cell text-gray-400">{{ equipo.sede }}</td>\r
          <td class="td-cell text-purple-400">{{ equipo.ligaNombre || 'Sin Liga' }}</td>\r
          <td class="td-cell" style="text-align:center">\r
            <div class="flex gap-2 justify-center">\r
              <a [routerLink]="['/admin/equipos', equipo.id]"\r
                 class="action-btn text-green-300 border-green-500/40 hover:bg-green-500/20"\r
                 title="Ver detalle">\r
                <i class="fas fa-eye text-xs"></i>\r
              </a>\r
              <button (click)="abrirEditar(equipo)"\r
                      class="action-btn text-blue-300 border-blue-500/40 hover:bg-blue-500/20"\r
                      title="Editar">\r
                <i class="fas fa-pen text-xs"></i>\r
              </button>\r
              <button (click)="eliminarEquipo(equipo.id)"\r
                      class="action-btn text-red-300 border-red-500/40 hover:bg-red-500/20"\r
                      title="Eliminar">\r
                <i class="fas fa-trash text-xs"></i>\r
              </button>\r
            </div>\r
          </td>\r
        </tr>\r
        </tbody>\r
      </table>\r
    </div>\r
\r
  </main>\r
\r
  <!-- Notificacion -->\r
  <div *ngIf="notificacion.mostrar"\r
       class="fixed bottom-6 right-6 z-50 px-5 py-3 rounded-xl text-sm font-semibold shadow-2xl"\r
       [ngClass]="notificacion.tipo === 'exito' ? 'bg-green-500/90 text-white' : 'bg-red-500/90 text-white'">\r
    {{ notificacion.mensaje }}\r
  </div>\r
\r
  <!-- Modal confirmacion -->\r
  <div *ngIf="modalConfirm.mostrar"\r
       class="fixed inset-0 z-50 flex items-center justify-center p-4"\r
       (click)="cerrarConfirm()">\r
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>\r
    <div class="relative z-10 w-full max-w-md bg-slate-900 rounded-2xl border border-red-500/30 p-6 shadow-2xl"\r
         (click)="$event.stopPropagation()">\r
      <div class="flex items-center justify-center w-14 h-14 rounded-full bg-red-500/15 border border-red-500/30 mx-auto mb-5">\r
        <i class="fas fa-triangle-exclamation text-red-400 text-xl"></i>\r
      </div>\r
      <h3 class="text-lg font-bold text-white text-center mb-2">{{ modalConfirm.titulo }}</h3>\r
      <p class="text-gray-400 text-sm text-center leading-relaxed mb-6">{{ modalConfirm.mensaje }}</p>\r
      <div class="flex gap-3">\r
        <button (click)="cerrarConfirm()" class="flex-1 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-lg border border-slate-600 transition-all">\r
          Cancelar\r
        </button>\r
        <button (click)="confirmar()" class="flex-1 px-4 py-2 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-semibold rounded-lg transition-all">\r
          <i class="fas fa-trash text-xs mr-1"></i> {{ modalConfirm.textoConfirmar }}\r
        </button>\r
      </div>\r
    </div>\r
  </div>\r
\r
</div>\r
